; $VER: Install-GFOpenBrowser 0.9.0 (4.11.2026)
; GFOpenBrowser's Installer script (SYS:System/Installer). Run it from its icon
; beside the GFOpenBrowser drawer; from a Shell, "Execute Install" in the drawer
; does the same without questions. Nothing is deleted: a file it would
; replace is renamed, and the closing message says how to undo.
; MIT, Copyright (c) 2026 AmiCradle Team.

(set #version "0.9.0 RC1 (4.11.2026)")
(set @app-name "GFOpenBrowser")
(set #stamp "20261104")
(set #backup (cat "LIBS:WebBrowser/WebBrowserEngine.before-" #stamp))
; the drawer as unpacked is about 87 MB: the one engine (WebBrowserEngine,
; which webbrowser.library runs), its fonts and the Unicode data
(set #need 95000000)

(if (< (/ (getversion) 65536) 47)
    (abort "GFOpenBrowser needs AmigaOS 3.2 or later. This Amiga has an older version."))
(if (or (= (database "fpu") "NOFPU")
        (not (or (= (database "cpu") "68040") (= (database "cpu") "68060"))))
    (abort "GFOpenBrowser needs a 68040 or 68060 with its FPU (not an LC or EC CPU)."))
(if (not (exists "GFOpenBrowser/Libs/WebBrowser/WebBrowserEngine"))
    (abort "Start Install-GFOpenBrowser from its icon, beside the GFOpenBrowser drawer it came with."))

(welcome
    (cat "This installs GFOpenBrowser " #version ": a WebKit web browser for "
         "AmigaOS 3.2, with its 68k JavaScript JIT."))

; Where the drawer goes. Not System: by default: the drawer is large, and a
; full System: stops the Amiga saving its settings.
(set #where
    (if (exists "Work:" (noreq)) "Work:" "SYS:Utilities"))
(set #where
    (askdir
        (prompt "Where should the GFOpenBrowser drawer go? It needs about 90 MB.")
        (help (cat "The drawer holds the browser and everything it uses. It can go on any "
                   "disk with room; Work: or another data partition is best. Putting it on "
                   "System: (SYS:) can fill that disk."))
        (default #where)))
(set #dest (tackon #where "GFOpenBrowser"))
(if (< (getdiskspace #where) #need)
    (abort (cat #where " has " (/ (getdiskspace #where) 1048576) " MB free, and GFOpenBrowser needs about "
                (/ #need 1048576) " MB. Choose another place, or make room, and run the Installer again.")))

; The extras: libraries other programs can use. Not needed by the browser.
(set #extras
    (askoptions
        (prompt "Also install these? GFOpenBrowser does not need them.")
        (help (cat "javascript.library runs JavaScript for any program; it puts about 38 MB "
                   "in LIBS:JavaScript. JS runs a script from the Shell."))
        (choices "javascript.library and JS (about 38 MB in LIBS:)")
        (default 0)))

; 1. The drawer and its icon. Over an older version's drawer: its engines
;    are renamed .before-<stamp> first (kept, not overwritten); 0.8.0 and
;    0.8.1 test had GFOpenBrowser.engine beside the launcher as well, which
;    the launcher no longer runs.
(set #renamed-drawer "")
(set #old-engine (tackon #dest "GFOpenBrowser.engine"))
(if (and (exists #old-engine) (not (exists (cat #old-engine ".before-" #stamp))))
    (
        (if (= 0 (rename #old-engine (cat #old-engine ".before-" #stamp)))
            (abort (cat "Could not rename " #old-engine ". Nothing was changed.")))
        (set #renamed-drawer (cat #renamed-drawer " GFOpenBrowser.engine"))))
; the older drawer's WebBrowserEngine, unless it is this one (run again)
(set #old-engine (tackon #dest "Libs/WebBrowser/WebBrowserEngine"))
(if (and (exists #old-engine)
         (<> (getsize #old-engine) (getsize "GFOpenBrowser/Libs/WebBrowser/WebBrowserEngine"))
         (not (exists (cat #old-engine ".before-" #stamp))))
    (
        (if (= 0 (rename #old-engine (cat #old-engine ".before-" #stamp)))
            (abort (cat "Could not rename " #old-engine ". Nothing was changed.")))
        (set #renamed-drawer (cat #renamed-drawer " Libs/WebBrowser/WebBrowserEngine"))))
(copyfiles
    (prompt "Copying the GFOpenBrowser drawer")
    (help @copyfiles-help)
    (source "GFOpenBrowser")
    (dest #dest)
    (all))
(if (exists "GFOpenBrowser.info")
    (copyfiles (source "GFOpenBrowser.info") (dest #where) (nogauge)))

; 2. https: GFOpenTLS 1.2 or newer and GFOpenCrypto 2.1 or newer, and the
;    certificates. An older library is renamed .before-20261104 (kept), then
;    the one in the drawer goes in; a newer one is left as it is.
(if (< (getversion "LIBS:gfopentls.library") 65538)
    (
        (if (exists "LIBS:gfopentls.library")
            (if (= 0 (rename "LIBS:gfopentls.library" "LIBS:gfopentls.library.before-20261104"))
                (abort "Could not rename the old LIBS:gfopentls.library. Nothing else was changed in LIBS:.")))
        (copyfiles (source "GFOpenBrowser/Libs/gfopentls.library") (dest "LIBS:") (nogauge))))
(if (< (getversion "LIBS:gfopencrypto.library") 131073)
    (
        (if (exists "LIBS:gfopencrypto.library")
            (if (= 0 (rename "LIBS:gfopencrypto.library" "LIBS:gfopencrypto.library.before-20261104"))
                (abort "Could not rename the old LIBS:gfopencrypto.library.")))
        (copyfiles (source "GFOpenBrowser/Libs/gfopencrypto.library") (dest "LIBS:") (nogauge))))
(if (not (exists "S:GFOpenTLS/ca-bundle.pem"))
    (
        (makedir "S:GFOpenTLS")
        (copyfiles (source "GFOpenBrowser/S/GFOpenTLS") (dest "S:GFOpenTLS") (all) (nogauge))))

; gfopenfont.library 1.4 or newer: the engine draws and shapes all its text
; with it. An older one is renamed .before-20261104 (kept).
(if (< (getversion "LIBS:gfopenfont.library") 65540)
    (
        (if (exists "LIBS:gfopenfont.library")
            (if (= 0 (rename "LIBS:gfopenfont.library" "LIBS:gfopenfont.library.before-20261104"))
                (abort "Could not rename the old LIBS:gfopenfont.library.")))
        (copyfiles (source "GFOpenBrowser/Libs/gfopenfont.library") (dest "LIBS:") (nogauge))))

; gfopenfont's CJK faces with their licences in FONTS:, where every program
; drawing with gfopenfont.library finds them: Droid Sans Fallback (Apache
; License 2.0) for Chinese and Japanese, NanumGothic (SIL OFL 1.1) for
; Korean, not boxes. One already there is kept.
(if (and (exists "GFOpenBrowser/Fonts/DroidSansFallbackFull.ttf")
         (not (exists "FONTS:DroidSansFallbackFull.ttf")))
    (copyfiles (source "GFOpenBrowser/Fonts") (dest "FONTS:")
        (choices "DroidSansFallbackFull.ttf" "DroidSansFallback.NOTICE") (nogauge)))
(if (and (exists "GFOpenBrowser/Fonts/NanumGothic-Regular.ttf")
         (not (exists "FONTS:NanumGothic-Regular.ttf")))
    (copyfiles (source "GFOpenBrowser/Fonts") (dest "FONTS:")
        (choices "NanumGothic-Regular.ttf" "NanumGothic.OFL.txt") (nogauge)))

; gfopengpu.library 0.24 or newer: the window is painted through it (without
; it, the engine paints with cairo, more slowly). An older one is renamed
; .before-20261104 (kept).
(if (< (getversion "LIBS:gfopengpu.library") 24)
    (
        (if (exists "LIBS:gfopengpu.library")
            (if (= 0 (rename "LIBS:gfopengpu.library" "LIBS:gfopengpu.library.before-20261104"))
                (abort "Could not rename the old LIBS:gfopengpu.library.")))
        (copyfiles (source "GFOpenBrowser/Libs/gfopengpu.library") (dest "LIBS:") (nogauge))))

; gfopenlayout.library 11 or newer: the window's dialogs, find bar,
; downloads and preferences are drawn by it. An older one is renamed
; .before-20261103 (kept).
(if (< (getversion "LIBS:gfopenlayout.library") 720896)
    (
        (if (exists "LIBS:gfopenlayout.library")
            (if (= 0 (rename "LIBS:gfopenlayout.library" "LIBS:gfopenlayout.library.before-20261103"))
                (abort "Could not rename the old LIBS:gfopenlayout.library.")))
        (copyfiles (source "GFOpenBrowser/Libs/gfopenlayout.library") (dest "LIBS:") (nogauge))))

; json.library: JSON for the browser and any other program (23 KB); the
; engine's JSON.parse parses through it
(copylib (source "GFOpenBrowser/Libs/json.library") (dest "LIBS:") (nogauge)
    (prompt "Installing json.library") (help @copylib-help) (confirm "expert"))

; unicode.library: Unicode (ICU 78.3) for the browser and any other program,
; one shared copy (4 MB); the engine's line breaking, normalisation, IDNA,
; collation and number and date formatting go through it. A package built
; without it carries none.
(if (exists "GFOpenBrowser/Libs/unicode.library")
    (copylib (source "GFOpenBrowser/Libs/unicode.library") (dest "LIBS:") (nogauge)
        (prompt "Installing unicode.library") (help @copylib-help) (confirm "expert")))

; Compressed pages: openweb.fetch's native transport decodes gzip and br
; through the datatypes stream class: z.library 53.12 (gzip.datatype opens
; it), stream.datatype, gzip.datatype and brotli.datatype 47.1 or newer in
; SYS:Classes/DataTypes, and their descriptors in DEVS:DataTypes. An older
; one is renamed .before-20261104 (kept), then the drawer's goes in; a
; descriptor goes in when missing. Without them pages still load,
; uncompressed.
(procedure P_newer #file #src #destdir #want
    (if (< (getversion #file) #want)
        (
            (if (exists #file)
                (if (= 0 (rename #file (cat #file ".before-" #stamp)))
                    (abort (cat "Could not rename the old " #file "."))))
            (copyfiles (source #src) (dest #destdir) (nogauge)))))
(P_newer "LIBS:z.library" "GFOpenBrowser/Libs/z.library" "LIBS:" 3473420)
(makedir "SYS:Classes/DataTypes")
(P_newer "SYS:Classes/DataTypes/stream.datatype" "GFOpenBrowser/Classes/DataTypes/stream.datatype" "SYS:Classes/DataTypes" 3080193)
(P_newer "SYS:Classes/DataTypes/gzip.datatype" "GFOpenBrowser/Classes/DataTypes/gzip.datatype" "SYS:Classes/DataTypes" 3080193)
(P_newer "SYS:Classes/DataTypes/brotli.datatype" "GFOpenBrowser/Classes/DataTypes/brotli.datatype" "SYS:Classes/DataTypes" 3080193)
(if (not (exists "DEVS:DataTypes/GZip"))
    (copyfiles (source "GFOpenBrowser/Devs/DataTypes/GZip") (dest "DEVS:DataTypes") (nogauge)))
(if (not (exists "DEVS:DataTypes/Brotli"))
    (copyfiles (source "GFOpenBrowser/Devs/DataTypes/Brotli") (dest "DEVS:DataTypes") (nogauge)))

; Animated GIFs: gfopengif.datatype 47.1 or newer gives every frame (the
; system's gif.datatype gives the first). Its descriptor, GFOpenGIF, is
; tried before the system's GIF one, which stays as it was.
(if (exists "GFOpenBrowser/Classes/DataTypes/gfopengif.datatype")
    (
        (P_newer "SYS:Classes/DataTypes/gfopengif.datatype" "GFOpenBrowser/Classes/DataTypes/gfopengif.datatype" "SYS:Classes/DataTypes" 3080193)
        (if (not (exists "DEVS:DataTypes/GFOpenGIF"))
            (copyfiles (source "GFOpenBrowser/Devs/DataTypes/GFOpenGIF") (dest "DEVS:DataTypes") (nogauge)))))

; 3. The Unicode data, for every program that reads it, when LOCALE: has room
;    for it and 2,000,000 bytes more; the engine in the drawer carries its own
;    copy as well (Libs/WebBrowser/Unicode, which it reads when LOCALE:Unicode
;    has none). One of another size is renamed icudt78b.dat.before-<stamp>.
;    No free space for LOCALE: (0, as a folder drive past its stated size
;    gives, or -1, not readable) is not known room: the copy is tried, and a
;    failure is reported, not the end of the installation.
(set #icu "LOCALE:Unicode/icudt78b.dat")
(set #icunew "GFOpenBrowser/Libs/WebBrowser/Unicode/icudt78b.dat")
(set #icufree (getdiskspace "LOCALE:"))
(set #icuneed (+ (getsize #icunew) 2000000))
(set #icumoved 0)
(if (and (not (and (exists #icu) (= (getsize #icu) (getsize #icunew))))
         (> #icufree 0) (<= #icufree #icuneed))
    (message (cat "LOCALE: has " #icufree " bytes free, and the Unicode data needs " #icuneed
                  " (the file and 2,000,000 bytes more), so it is not copied to LOCALE:Unicode. "
                  "GFOpenBrowser reads the drawer's copy; other programs that use unicode.library "
                  "need LOCALE:Unicode/icudt78b.dat.") (all))
    (
        (if (and (exists #icu) (<> (getsize #icu) (getsize #icunew)))
            (if (exists (cat #icu ".before-" #stamp))
                (abort (cat "LOCALE:Unicode has both icudt78b.dat and icudt78b.dat.before-" #stamp
                            ". Move one of them away and run the Installer again."))
                (if (= 0 (rename #icu (cat #icu ".before-" #stamp)))
                    (abort "Could not rename LOCALE:Unicode/icudt78b.dat.")
                    (set #icumoved 1))))
        (if (not (exists #icu))
            (
                (makedir "LOCALE:Unicode")
                (copyfiles (source "GFOpenBrowser/Libs/WebBrowser/Unicode") (dest "LOCALE:Unicode") (all) (nogauge)
                    (optional "nofail"))
                (if (or (not (exists #icu)) (<> (getsize #icu) (getsize #icunew)))
                    (
                        ; a part-written file would break every program that reads
                        ; it: renamed out of the way (not deleted), and the file
                        ; renamed above goes back
                        (if (exists #icu)
                            (rename #icu (cat #icu ".incomplete-" #stamp)))
                        (if (= #icumoved 1)
                            (rename (cat #icu ".before-" #stamp) #icu))
                        (message (cat "Could not copy the Unicode data to LOCALE:Unicode (is System: full?). "
                                      "GFOpenBrowser reads the drawer's copy; other programs that use "
                                      "unicode.library need LOCALE:Unicode/icudt78b.dat.") (all))
                        (transcript "LOCALE:Unicode/icudt78b.dat: copy failed")))))))

; 4. One engine: WebBrowserEngine stays in the drawer, off System:.
;    webbrowser.library runs LIBS:WebBrowser/WebBrowserEngine when there is
;    one, otherwise the drawer's Libs/WebBrowser/WebBrowserEngine (for the
;    GFOpenBrowser in the drawer). An older LIBS:WebBrowser/WebBrowserEngine,
;    the engine or the two-line script that 0.8.0 and 0.8.1 test wrote
;    there, is renamed WebBrowserEngine.before-<stamp> (kept); nothing new
;    is written in LIBS:WebBrowser.
(set #enginefile "LIBS:WebBrowser/WebBrowserEngine")
(set #renamed 0)
(if (exists #enginefile)
    (if (exists #backup)
        (abort (cat "LIBS:WebBrowser has both WebBrowserEngine and " (fileonly #backup)
                    ". Move one of them away and run the Installer again."))
        (
            (if (= 0 (rename #enginefile #backup
                        (prompt "Keeping the old LIBS:WebBrowser/WebBrowserEngine as " (fileonly #backup))
                        (help "GFOpenBrowser now runs the engine in its drawer. Renaming it back undoes the change.")))
                (abort "Could not rename LIBS:WebBrowser/WebBrowserEngine. Nothing else was changed in LIBS:WebBrowser."))
            (set #renamed 1))))

; 5. The extras
(if (bitand #extras 1)
    (
        (copyfiles (source "Extras/Libs/javascript.library") (dest "LIBS:") (nogauge))
        (makedir "LIBS:JavaScript")
        (copyfiles (source "Extras/Libs/JavaScript") (dest "LIBS:JavaScript") (all))
        ; a browser engine that takes JavaScriptCore from JavaScriptEngine
        ; looks in LIBS:JavaScript first: its own image goes there, so the
        ; engine and javascript.library use one file
        (if (exists "GFOpenBrowser/Libs/JavaScript/JavaScriptEngine")
            (copyfiles (source "GFOpenBrowser/Libs/JavaScript/JavaScriptEngine") (dest "LIBS:JavaScript") (nogauge)))
        ; JavaScriptEngine reads ICU's data from LOCALE:Unicode, or else
        ; from its own drawer
        (if (not (exists "LOCALE:Unicode/icudt78b.dat"))
            (
                (makedir "LIBS:JavaScript/Unicode")
                (copyfiles (source "GFOpenBrowser/Libs/WebBrowser/Unicode") (dest "LIBS:JavaScript/Unicode") (all) (nogauge))))
        (copyfiles (source "Extras/C/JS") (dest "C:") (nogauge))))

(if (not (exists "LIBS:bsdsocket.library"))
    (message (cat "There is no bsdsocket.library: GFOpenBrowser needs a network. "
                  "On AmiCradle turn networking on for this instance in Cradle; "
                  "otherwise install GFOpenSocket (GFOpenUp) or another TCP/IP stack.")))

(set @default-dest #dest)
(exit
    (cat "GFOpenBrowser is in " #dest ". Reboot, then double-click GFOpenBrowser there.\n\n"
         "To undo: "
         (if (<> #renamed-drawer "")
             (cat "an older GFOpenBrowser was in that drawer; its" #renamed-drawer " is kept there as .before-" #stamp ", to rename back")
             "delete that drawer")
         (if (or #renamed (exists #backup)) (cat "; rename " #backup " back to WebBrowserEngine") "")
         ". What the Installer added to LIBS:, S: and LOCALE: is listed in the Installer's log in that drawer (Install-GFOpenBrowser.log from the icon; read it before deleting the drawer).")
    (quiet))
