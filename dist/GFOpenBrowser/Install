; Compressed pages: openweb.fetch's native transport decodes gzip and br
; through the datatypes stream class. LIBS:z.library 53.12 (gzip.datatype
; opens it) and SYS:Classes/DataTypes/stream.datatype, gzip.datatype and
; brotli.datatype 47.1 or newer: a missing one goes in; an older one is
; renamed .before-20261101 and the drawer's goes in; one whose version
; cannot be read is kept. DEVS:DataTypes/GZip and Brotli go in when missing.
; Without them pages still load, uncompressed.
If NOT EXISTS SYS:Classes/DataTypes
  MakeDir SYS:Classes/DataTypes >NIL:
EndIf

Version LIBS:z.library 53 12 >NIL:
Set vrc $RC
If $vrc EQ 0 VAL
  Echo "LIBS:z.library is new enough, kept"
  Skip zlibdone
EndIf
If $vrc GE 10 VAL
  If EXISTS LIBS:z.library
    Echo "LIBS:z.library is there; its version cannot be read from the Shell, so it is kept (Install-GFOpenBrowser checks it)"
    Skip zlibdone
  EndIf
Else
  Rename LIBS:z.library LIBS:z.library.before-20261101
  If WARN
    Echo "Could not rename the old LIBS:z.library"
    Quit 20
  EndIf
  Echo "Kept the old LIBS:z.library as z.library.before-20261101"
EndIf
Copy Libs/z.library LIBS: QUIET
If WARN
  Echo "Could not copy z.library to LIBS:"
  Quit 20
EndIf
Echo "Installed LIBS:z.library"
Lab zlibdone

