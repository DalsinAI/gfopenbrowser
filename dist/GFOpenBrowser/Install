EndIf

; the Unicode data in LOCALE:Unicode/, for every program that reads it (the
; engine reads it there first, then from Libs/WebBrowser/Unicode/), when
; LOCALE: has room for the file and 2,000,000 bytes more, as the Installer
; asks; one of another size is kept as icudt78b.dat.before-20261101.
; Without the room nothing in LOCALE: is touched. Info gives 0 free (a folder
; drive past its stated size does) or nothing readable: the room is not
; known, so the copy is tried and a failure is reported.
; A command's output goes into a variable through a small .KEY script in T:
; and a one-line script that runs it with that output as its arguments (no
; backquotes: some Shells, such as Instance-32's, do not expand them).
Echo ".KEY a,b,c,d,e,f,g,h/F" >T:ob-set-icunew
Echo ".BRA {" >>T:ob-set-icunew
Echo ".KET }" >>T:ob-set-icunew
Copy T:ob-set-icunew T:ob-set-icuold QUIET
Copy T:ob-set-icunew T:ob-set-icufree QUIET
Copy T:ob-set-icunew T:ob-set-icuneed QUIET
Echo "Set icunew {a}" >>T:ob-set-icunew
Echo "Set icuold {a}" >>T:ob-set-icuold
Echo ".KEY a,b/F" >T:ob-set-icudir
Echo ".BRA {" >>T:ob-set-icudir
Echo ".KET }" >>T:ob-set-icudir
Echo "Set icudir *"{b}*"" >>T:ob-set-icudir
Echo "Set icufree {d}" >>T:ob-set-icufree
Echo "Set icuneed {a}" >>T:ob-set-icuneed
Set icunew 0
Set icuold 0
Set icufree 0
Set icuneed 0
Set icumoved 0
Set icudir ""
Echo "Execute T:ob-set-icunew " NOLINE >T:ob-icu-run
List Libs/WebBrowser/Unicode/icudt78b.dat LFORMAT "%L" >>T:ob-icu-run
Execute T:ob-icu-run
If EXISTS LOCALE:Unicode/icudt78b.dat
  Echo "Execute T:ob-set-icuold " NOLINE >T:ob-icu-run
  List LOCALE:Unicode/icudt78b.dat LFORMAT "%L" >>T:ob-icu-run
  Execute T:ob-icu-run
  If $icuold EQ $icunew
    Echo "LOCALE:Unicode/icudt78b.dat is there, kept"
    Skip icudone
  EndIf
EndIf
; LOCALE:'s free blocks. Info takes a volume or a path on one, not an
; assign: Assign's list gives LOCALE:'s path (its first directory), and
; Info's disk line (the one with the "%" of Full) its Free column. Info
; counts blocks; at 512 bytes or more each, the file's size plus 2,000,000
; bytes, over 512, is the most blocks it needs (a disk with larger blocks may
; be skipped with less room needed, never filled). 0 blocks, or a Free column
; that is not a number, is not known room: the copy is tried.
Assign LIST >T:ob-icu-assign
Echo "Execute T:ob-set-icudir " NOLINE >T:ob-icu-run
Search T:ob-icu-assign "LOCALE #?" PATTERN NONUM >>T:ob-icu-run
Execute T:ob-icu-run
Info "$icudir" >T:ob-icu-info
Echo "Execute T:ob-set-icufree " NOLINE >T:ob-icu-run
Search T:ob-icu-info "%" NONUM >>T:ob-icu-run
Execute T:ob-icu-run
Echo "Execute T:ob-set-icuneed " NOLINE >T:ob-icu-run
Eval ( $icunew + 2000000 ) / 512 + 1 >>T:ob-icu-run
Execute T:ob-icu-run
If VAL $icufree GT 0
  If NOT VAL $icufree GT $icuneed
    Echo "Not copying the Unicode data to LOCALE:Unicode: LOCALE: ($icudir) has $icufree blocks free, and it needs $icuneed (the file's $icunew bytes and 2,000,000 more). The engine reads the drawer's copy, Libs/WebBrowser/Unicode/icudt78b.dat, instead."
    Skip icudone
  EndIf
Else
  Echo "Info gives no free space for LOCALE: ($icudir: $icufree blocks), so the room is not known; trying the copy"
EndIf
If EXISTS LOCALE:Unicode/icudt78b.dat
  If EXISTS LOCALE:Unicode/icudt78b.dat.before-20261101
    Echo "LOCALE:Unicode has both icudt78b.dat and icudt78b.dat.before-20261101: move one of them away and run Install again."
    Quit 20
  EndIf
  Rename LOCALE:Unicode/icudt78b.dat LOCALE:Unicode/icudt78b.dat.before-20261101
  If WARN
    Echo "Could not rename LOCALE:Unicode/icudt78b.dat"
    Quit 20
  EndIf
  Echo "Kept the other LOCALE:Unicode/icudt78b.dat ($icuold bytes) as icudt78b.dat.before-20261101"
  Set icumoved 1
EndIf
If NOT EXISTS LOCALE:Unicode
  MakeDir LOCALE:Unicode >NIL:
EndIf
Copy Libs/WebBrowser/Unicode/icudt78b.dat LOCALE:Unicode/ QUIET
If WARN
  Echo "Could not copy the Unicode data to LOCALE:Unicode (is System: full?); the engine reads the drawer's copy, but other programs that use unicode.library need LOCALE:Unicode/icudt78b.dat"
  ; a part-written file would break every program that reads it: it is
  ; renamed out of the way (not deleted), and the file renamed above goes back
  If EXISTS LOCALE:Unicode/icudt78b.dat
    Rename LOCALE:Unicode/icudt78b.dat LOCALE:Unicode/icudt78b.dat.incomplete-20261101 >NIL:
    Echo "The part-written copy is LOCALE:Unicode/icudt78b.dat.incomplete-20261101"
  EndIf
  If $icumoved EQ 1
    Rename LOCALE:Unicode/icudt78b.dat.before-20261101 LOCALE:Unicode/icudt78b.dat >NIL:
    Echo "LOCALE:Unicode/icudt78b.dat is the one it had before"
  EndIf
Else
  Echo "Installed LOCALE:Unicode/icudt78b.dat"
EndIf
Lab icudone
UnSet icunew
UnSet icuold
UnSet icufree
UnSet icuneed
UnSet icumoved
UnSet icudir

If EXISTS LIBS:WebBrowser/WebBrowserEngine
  If EXISTS LIBS:WebBrowser/WebBrowserEngine.before-20261101
    Echo "LIBS:WebBrowser has both WebBrowserEngine and WebBrowserEngine.before-20261101: move one of them away and run Install again."
    Quit 20
  EndIf
  Rename LIBS:WebBrowser/WebBrowserEngine LIBS:WebBrowser/WebBrowserEngine.before-20261101
  If WARN
    Echo "Could not rename LIBS:WebBrowser/WebBrowserEngine; nothing changed in LIBS:WebBrowser."
    Quit 20
  EndIf
  Echo "Kept the old LIBS:WebBrowser/WebBrowserEngine as WebBrowserEngine.before-20261101"
EndIf
Echo "webbrowser.library runs the engine in this drawer"

If EXISTS GFOpenBrowser.engine
  If NOT EXISTS GFOpenBrowser.engine.before-20261101
    Rename GFOpenBrowser.engine GFOpenBrowser.engine.before-20261101
    If WARN
      Echo "Could not rename the old GFOpenBrowser.engine in this drawer"
      Quit 20
    EndIf
    Echo "Kept an older version's GFOpenBrowser.engine as GFOpenBrowser.engine.before-20261101 (no longer used)"
  EndIf
EndIf

If NOT EXISTS LIBS:bsdsocket.library
  Echo "No LIBS:bsdsocket.library: turn networking on for this instance in Cradle, or install GFOpenSocket from GFOpenUp."
EndIf
Echo "Done. Reboot, then start GFOpenBrowser from this drawer."
