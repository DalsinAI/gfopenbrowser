+#if CPU(M68K)
+// Diagnostic for the reddit worker's lost Structure (gfopenbrowser, not for
+// main): is cell a live cell of its heap? A cell whose block has gone back
+// to the allocator counts as dead.
+bool obgcCellIsLive(VM& vm, const JSCell* cell)
+{
+    if (!cell)
+        return true;
+    if (cell->isPreciseAllocation())
+        return true;
+    MarkedBlock* block = &cell->markedBlock();
+    if (!vm.heap.objectSpace().blocks().set().contains(block))
+        return false;
+    return block->handle().isLive(cell);
+}
+
+static unsigned obgcReports;
+
+// 1 when the cell's block is the one its allocator is handing cells out of:
+// there a cell allocated since the last collection reads as not live, so a
+// report is only a lead.
+static int obgcFreeListed(VM& vm, const JSCell* cell)
+{
+    if (!cell || cell->isPreciseAllocation())
+        return 0;
+    MarkedBlock* block = &cell->markedBlock();
+    if (!vm.heap.objectSpace().blocks().set().contains(block))
+        return -1;
+    return block->handle().isFreeListed();
+}
+
+void obgcReport(const char* what, VM& vm, const JSCell* a, const JSCell* b, const void* c, unsigned d)
+{
+    if (obgcReports >= 40)
+        return;
+    obgcReports++;
+    dataLogLn("OBGC_", what, " vm ", RawPointer(&vm), " a ", RawPointer(a), " live ", obgcCellIsLive(vm, a),
+        " fl ", obgcFreeListed(vm, a),
+        " b ", RawPointer(b), " live ", obgcCellIsLive(vm, b), " fl ", obgcFreeListed(vm, b), " c ", RawPointer(c), " d ", d,
+        " gc ", vm.heap.objectSpace().markingVersion());
+}
+#endif
