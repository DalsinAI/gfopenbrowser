+// Dead for sure: not live, and not in the block being allocated from (there
+// a cell made since the last GC reads as not live).
+bool obgcCellIsDead(VM& vm, const JSCell* cell)
+{
+    return !obgcCellIsLive(vm, cell) && obgcFreeListed(vm, cell) != 1;
+}
