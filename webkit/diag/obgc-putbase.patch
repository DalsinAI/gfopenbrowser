+// The base cell of the put_by_id slow path each VM is in (LLIntSlowPaths.cpp),
+// and the heap's newlyAllocatedVersion when it entered.
+struct ObgcPutBase {
+    VM* vm;
+    const JSCell* base;
+    unsigned version;
+};
+static ObgcPutBase obgcPutBases[8];
+
+void obgcNotePutBase(VM& vm, const JSCell* base)
+{
+    unsigned version = vm.heap.objectSpace().newlyAllocatedVersion();
+    for (auto& entry : obgcPutBases) {
+        if (entry.vm == &vm || !entry.vm) {
+            entry = { &vm, base, version };
+            return;
+        }
+    }
+    obgcPutBases[0] = { &vm, base, version };
+}
