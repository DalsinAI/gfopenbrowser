+/* COMPOSITE_PD of a solid colour over r through the clip's mask, as cairo
+ * composites through a clip mask: clear is the destination times 1 - the
+ * mask (destination-out of an opaque colour), copy that and then the
+ * colour times the mask added (cairo's lerp of the two). */
+static int maskedFill(struct obgpu *g, const int *r, unsigned long argb, int pd)
+{
+    const struct obgpu_mask *k = clipMask(g);
+    unsigned long a[7];
+    int slot = maskSlot(g, k), pass, passes = pd == OGPU_PD_SRC ? 2 : 1;
+    for (pass = 0; pass < passes; pass++) {
+        int op = pd;
+        unsigned long colour = argb;
+        if (pd == OGPU_PD_CLEAR || (pd == OGPU_PD_SRC && !pass)) {
+            op = OGPU_PD_OUT_REVERSE;
+            colour = 0xFF000000UL;
+        } else if (pd == OGPU_PD_SRC) {
+            op = OGPU_PD_ADD;
+            if (!argb)
+                break;
+        }
+        a[0] = (unsigned long)op | OGPU_PD_SOLID | OGPU_PD_MASK;
+        a[1] = colour;
+        a[2] = 0;
+        a[3] = (unsigned long)slot;
+        a[4] = xy(r[0] - k->x, r[1] - k->y);
+        a[5] = xy(r[0], r[1]);
+        a[6] = xy(r[2] - r[0], r[3] - r[1]);
+        emit(g, OGPU_OP_COMPOSITE_PD, 7, a);
+        g->drawn++;
+        g->counts->draws++;
+    }
+    return 1;
+}
