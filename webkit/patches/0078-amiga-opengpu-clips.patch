+            l->cx1 = l->cx0;
+            l->cy1 = l->cy0;
+        }
+        return 1;
+    }
+    /* clipping in, nothing outside the path's box is left */
+    if (!out) {
+        if (b[0] > l->cx0) l->cx0 = b[0];
+        if (b[1] > l->cy0) l->cy0 = b[1];
+        if (b[2] < l->cx1) l->cx1 = b[2];
+        if (b[3] < l->cy1) l->cy1 = b[3];
+        if (l->cx1 <= l->cx0 || l->cy1 <= l->cy0) {
+            l->cx1 = l->cx0;
+            l->cy1 = l->cy0;
+            g->scratch_used = start;
+            return 1;
+        }
+    } else if (b[2] <= l->cx0 || b[0] >= l->cx1 || b[3] <= l->cy0 || b[1] >= l->cy1) {
+        g->scratch_used = start;
+        return 1;
+    }
+    if (l->cx1 <= l->cx0 || l->cy1 <= l->cy0) {
+        g->scratch_used = start;
+        return 1;
+    }
+    /* this level's own mask takes the path itself; else a new one, from the
+     * clip so far */
+    own = l->mask && g->mask[l->mask].block && g->mask[l->mask].depth == g->depth;
