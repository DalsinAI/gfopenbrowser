+
+void obgpu_masks(struct obgpu *g, obgpu_alloc_fn alloc, obgpu_free_fn release, void *user)
+{
+    g->mask_alloc = alloc;
+    g->mask_free = release;
+    g->mask_user = user;
+}
+
+static void freeMask(struct obgpu *g, int i)
+{
+    if (g->mask[i].block && g->mask_free)
+        g->mask_free(g->mask_user, g->mask[i].block);
+    g->mask[i].block = 0;
+}
+
+void obgpu_release_masks(struct obgpu *g)
+{
+    dropMasks(g, 0);
+}
+
+void obgpu_set_antialias(struct obgpu *g, int on)
+{
+    g->aliased = !on;
+}
+
+/* The clip's mask, or 0. */
+static const struct obgpu_mask *clipMask(const struct obgpu *g)
+{
+    int i = g->level[g->depth].mask;
+    return i > 0 && i < OBGPU_MASKS && g->mask[i].block ? &g->mask[i] : 0;
+}
