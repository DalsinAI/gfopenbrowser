+/* A mask's slot in this batch. */
+static int maskSlot(struct obgpu *g, const struct obgpu_mask *k)
+{
+    struct obgpu_source s;
+    s.address = k->address;
+    s.bpr = k->bpr;
+    s.w = k->w;
+    s.h = k->h;
+    s.format = OBGPU_A8;
