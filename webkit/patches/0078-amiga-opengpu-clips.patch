+    int state = g->path_state, out = (flags & OBGPU_CLIP_OUT) != 0, own, i, b[4], slot, pslot = 0;
+    obgpu_s64 m[6];
+    unsigned long a[15];
+    g->path_state = 0;
+    if (state != OBGPU_PATH_OPEN) {
+        if (state)
+            g->scratch_used = start;
+        goto other;
+    }
+    if (!g->mask_alloc || !(g->caps & OBGPU_CAN_PATH) || !g->work || !obgpu_drawable(g)
+        || ((flags & OBGPU_CLIP_ALIASED) && !(g->caps & OBGPU_CAN_ALIASED)))
+        goto drop;
+    if (!g->path_any || !pathBox(g, b)) {
+        /* no area: clipped to nothing, or clipped out of nothing */
+        g->scratch_used = start;
