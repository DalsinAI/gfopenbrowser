+// A clip mask's memory: the engine's own, as the batch's (the CPU back end
+// reads it where it is; a driver gets it through the library).
+unsigned char* GraphicsContextOpenGPU::allocMask(void*, unsigned long bytes, unsigned long* address)
+{
+    void* block = nullptr;
+    if (!tryFastMalloc(bytes).getValue(block))
+        return nullptr;
+    *address = reinterpret_cast<uintptr_t>(block);
+    return static_cast<unsigned char*>(block);
+}
