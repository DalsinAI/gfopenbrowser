 {
     m_cairo.clipPath(path, windRule);
-    if (m_gpu)
-        obgpu_clip_other(m_gpu);
+    // anti-aliased, as Cairo::clipPath enforces
+    clipToPath(path, windRule == WindRule::EvenOdd ? OBGPU_CLIP_EVENODD : 0);
