+/* ---- clips to paths -------------------------------------------------------------------- */
+
+/* A path word as the signed 24.8 it is. */
+static long sget(const unsigned char *p)
+{
+    unsigned long v = get(p);
+    return v & 0x80000000UL ? -(long)((~v & 0x7FFFFFFFUL) + 1) : (long)v;
+}
+
+/* The open path's box on the target, whole pixels (x0 <= x < x1), from its
+ * points and control points through the transform. 0 when it has none. */
+static int pathBox(struct obgpu *g, int *b)
+{
+    const long *m = current(g)->m;
+    const unsigned char *w = g->scratch + g->path_start * 4;
+    long len = g->scratch_used - g->path_start, at = 0;
+    obgpu_s64 x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    int any = 0, k, np;
+    while (at < len) {
+        unsigned long v = get(w + at * 4);
+        np = v == OGPU_PATH_QUAD ? 2 : v == OGPU_PATH_CUBIC ? 3 : v == OGPU_PATH_CLOSE ? 0 : 1;
+        for (at++, k = 0; k < np && at + 1 < len; k++, at += 2) {
+            long px = sget(w + at * 4), py = sget(w + at * 4 + 4);
+            obgpu_s64 tx = mapX(m, px, py), ty = mapY(m, px, py);
+            if (!any || tx < x0) x0 = tx;
+            if (!any || tx > x1) x1 = tx;
+            if (!any || ty < y0) y0 = ty;
+            if (!any || ty > y1) y1 = ty;
+            any = 1;
+        }
+    }
+    if (!any)
+        return 0;
+    /* a pixel round it for the anti-aliased edge */
+    x0 = floorShift(x0, 8) - 1;
+    y0 = floorShift(y0, 8) - 1;
+    x1 = floorShift(x1 + 255, 8) + 1;
+    y1 = floorShift(y1 + 255, 8) + 1;
+    b[0] = x0 < -OBGPU_MAX_SIDE ? -OBGPU_MAX_SIDE : (int)x0;
+    b[1] = y0 < -OBGPU_MAX_SIDE ? -OBGPU_MAX_SIDE : (int)y0;
+    b[2] = x1 > 2 * OBGPU_MAX_SIDE ? 2 * OBGPU_MAX_SIDE : (int)x1;
+    b[3] = y1 > 2 * OBGPU_MAX_SIDE ? 2 * OBGPU_MAX_SIDE : (int)y1;
+    return 1;
+}
