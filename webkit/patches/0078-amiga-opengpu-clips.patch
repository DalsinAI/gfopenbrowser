+    for (i = 1; i < OBGPU_MASKS; i++)
+        if (g->mask[i].block && g->mask[i].depth >= depth) {
+            if (!sent) {
+                obgpu_flush(g);
+                sent = 1;
+            }
+            freeMask(g, i);
