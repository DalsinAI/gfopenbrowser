+#pragma once
+
+/* Which way a picture's bytes go to the datatypes (DatatypesDecode.c), in
+ * plain C with no Amiga headers so the host can test it.
+ *
+ * datatypes.library 47.100 and later (the open one, gfopendatatypes) takes a
+ * picture straight from memory (DTST_MEMORY), and its picture classes copy
+ * the bytes; OS 3.2's library (47.x below 100) and its picture datatypes
+ * read files only, so there the picture goes through a file in T:. */
+#define OBDT_MEMORY_VERSION 47
+#define OBDT_MEMORY_REVISION 100
+
+/* 1 when a datatypes.library of this version and revision is asked for the
+ * picture from memory first; 0 when only a file is tried. */
+static inline int obdt_source_from_memory(unsigned version, unsigned revision)
+{
+    if (version != OBDT_MEMORY_VERSION)
+        return version > OBDT_MEMORY_VERSION;
+    return revision >= OBDT_MEMORY_REVISION;
+}
