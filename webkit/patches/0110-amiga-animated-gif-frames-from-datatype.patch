 #include "ScalableImageDecoder.h"
 
 namespace WebCore {
@@ -32,7 +33,8 @@ namespace WebCore {
 // Every bitmap image in a page is decoded by the system's datatypes, so the
 // formats a page can show are the ones the user has datatypes for: OS 3.2
