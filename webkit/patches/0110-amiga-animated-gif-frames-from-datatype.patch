-// as soon as it arrives; the pixels when all of the file is in.
+// as soon as it arrives; the pixels when all of the file is in. An animated
+// GIF plays when a datatype gives its frames (gfopengif.datatype).
 class DatatypesImageDecoder final : public ScalableImageDecoder {
 public:
     static Ref<ScalableImageDecoder> create(AlphaOption alphaOption, GammaAndColorProfileOption gammaAndColorProfileOption)
@@ -40,17 +42,29 @@ public:
         return adoptRef(*new DatatypesImageDecoder(alphaOption, gammaAndColorProfileOption));
     }
 
+    ~DatatypesImageDecoder();
+
     String filenameExtension() const final { return "dt"_s; }
+    RepetitionCount repetitionCount() const final;
 
 private:
     DatatypesImageDecoder(AlphaOption, GammaAndColorProfileOption);
 
     void tryDecodeSize(bool allDataReceived) final;
     ScalableImageDecoderFrame* frameBufferAtIndex(size_t) final WTF_REQUIRES_LOCK(m_lock);
+    size_t decodeIfNeededAndGetFrameCount() const final WTF_REQUIRES_LOCK(m_lock);
+    void clearDecodedPixelDataIfNeeded(size_t) final WTF_REQUIRES_LOCK(m_lock);
 
     bool decodeAll() WTF_REQUIRES_LOCK(m_lock);
+    void openAnimationIfNeeded() const WTF_REQUIRES_LOCK(m_lock);
+    bool decodeFrame(size_t) WTF_REQUIRES_LOCK(m_lock);
 
     bool m_decodeAttempted { false };
+    // An animated GIF's frames from the datatype (see DatatypesDecode.h).
+    mutable OBDTAnimation m_animation { };
+    mutable bool m_animationTried { false };
+    mutable size_t m_frameCount { 1 };
+    mutable RepetitionCount m_repetitionCount { RepetitionCountNone };
 };
 
 } // namespace WebCore
