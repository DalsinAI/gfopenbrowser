+/*
+ * Path without cairo (patch 0083): WebCore's own segments (a PathStream
+ * kept inside, holding only moves, lines, curves and closes: arcs,
+ * ellipses and rectangles become those as they are added), with what Path asks of a platform path: hit testing (fill
+ * and stroke) and the stroke's bounds, on the path flattened to lines.
+ * GraphicsContextOpenGPU reads the elements, as it did from PathCairo.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "PathImpl.h"
+#include "PathStream.h"
+#include "PlatformPath.h"
+#include "WindRule.h"
+
+namespace WebCore {
+
+class GraphicsContext;
+
+class PathAmiga final : public PathImpl {
+    WTF_MAKE_TZONE_ALLOCATED(PathAmiga);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(PathAmiga);
+public:
+    WEBCORE_EXPORT static Ref<PathAmiga> create(std::span<const PathSegment> = { });
+    static PlatformPathPtr emptyPlatformPath();
+
+    explicit PathAmiga(Ref<PathStream>&&);
+
+    PlatformPathPtr platformPath() const { return const_cast<PathAmiga*>(this); }
+
+    void addPath(const PathAmiga&, const AffineTransform&);
+
+    bool definitelyEqual(const PathImpl&) const final;
+    Ref<PathImpl> copy() const final;
+    void add(PathMoveTo) final;
+    void add(PathLineTo) final;
+    void add(PathQuadCurveTo) final;
+    void add(PathBezierCurveTo) final;
+    void add(PathArcTo) final;
+    void add(PathArc) final;
+    void add(PathClosedArc) final;
+    void add(PathEllipse) final;
+    void add(PathEllipseInRect) final;
+    void add(PathRect) final;
+    void add(PathRoundedRect) final;
+    void add(PathContinuousRoundedRect) final;
+    void add(PathCloseSubpath) final;
+
+    const Vector<PathSegment>* segmentsIfExists() const LIFETIME_BOUND final { return static_cast<const PathImpl&>(m_stream.get()).segmentsIfExists(); }
+    Vector<PathSegment> segments() const final { return static_cast<const PathImpl&>(m_stream.get()).segments(); }
+    void applySegments(NOESCAPE const PathSegmentApplier&) const final;
+    bool applyElements(NOESCAPE const PathElementApplier&) const final;
+
+    bool transform(const AffineTransform&) final;
+
+    bool contains(const FloatPoint&, WindRule) const;
+    bool strokeContains(const FloatPoint&, NOESCAPE const Function<void(GraphicsContext&)>& strokeStyleApplier) const;
+    FloatRect strokeBoundingRect(NOESCAPE const Function<void(GraphicsContext&)>& strokeStyleApplier) const;
+
+private:
+    FloatPoint currentPoint() const final;
+    FloatRect fastBoundingRect() const final;
+    FloatRect boundingRect() const final;
+    bool hasSubpaths() const final;
+    bool isClosed() const final;
+
+    bool hasCurrentPoint() const;
+    void addArc(const FloatPoint& center, float radiusX, float radiusY, float rotation, float startAngle, float endAngle, bool clockwise);
+
+    // The path as polylines (curves cut into lines a quarter pixel from the curve).
+    void flatten(NOESCAPE const Function<void(const FloatPoint&, const FloatPoint&, bool startsSubpath)>&) const;
+
+    Ref<PathStream> m_stream;
+};
+
+} // namespace WebCore
+
+SPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::PathAmiga)
+    static bool isType(const WebCore::PathImpl& pathImpl) { return !pathImpl.isPathStream(); }
+SPECIALIZE_TYPE_TRAITS_END()
+
+#endif // USE(AMIGA_GRAPHICS)
