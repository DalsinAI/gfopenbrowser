diff --git a/Source/WebCore/platform/graphics/amiga/GraphicsAmiga.cpp b/Source/WebCore/platform/graphics/amiga/GraphicsAmiga.cpp
new file mode 100644
index 00000000..eda5f3ed
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/GraphicsAmiga.cpp
@@ -0,0 +1,73 @@
+/*
+ * The small platform pieces cairo's files gave WebCore (patch 0083):
+ * Gradient's stopsChanged and fill (GradientCairo.cpp), Pattern's platform
+ * pattern (PatternCairo.cpp: none, GraphicsContextOpenGPU reads Pattern
+ * itself), a decoder frame as a picture (ImageBackingStoreCairo.cpp) and
+ * PNG out through the datatypes (ImageUtilitiesCairo.cpp's Amiga part).
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "AmigaImage.h"
+#include "DatatypesDecode.h"
+#include "Gradient.h"
+#include "GraphicsContext.h"
+#include "ImageBackingStore.h"
+#include "ImageUtilities.h"
+#include "NativeImage.h"
+#include "Pattern.h"
+
+namespace WebCore {
+
+void Gradient::stopsChanged()
+{
+}
+
+// GraphicsContextCairo's Gradient::fill: the rectangle filled with the
+// gradient in the fill's gradient space, no global alpha.
+void Gradient::fill(GraphicsContext& context, const FloatRect& rect)
+{
+    context.fillRect(rect, *this);
+}
+
+PlatformPatternPtr Pattern::createPlatformPattern(const AffineTransform&) const
+{
+    return nullptr;
+}
+
+// The decoder's pixels as they are (premultiplied ARGB32 words), held by
+// the picture until it goes.
+PlatformImagePtr ImageBackingStore::image() const
+{
+    m_pixels->ref();
+    auto* segment = m_pixels.get();
+    return AmigaImage::wrap(reinterpret_cast<uint8_t*>(const_cast<uint32_t*>(m_pixelsSpan.data())), size(),
+        size().width() * sizeof(uint32_t), true, [segment] {
+            segment->deref();
+        });
+}
+
+// PNG through the system's datatypes (a PNG datatype's DTM_WRITE);
+// obdt_encode_png() undoes the premultiplication.
+Vector<uint8_t> platformEncodeData(const NativeImage& nativeImage, const String& mimeType, std::optional<double>)
+{
+    ASSERT_UNUSED(mimeType, mimeType == "image/png"_s);
+    auto image = nativeImage.platformImage();
+    if (!image)
+        return { };
+    unsigned char* data = nullptr;
+    unsigned long size = 0;
+    if (!obdt_encode_png(image->data(), image->width(), image->height(), image->stride(),
+        image->hasAlpha() ? OBDT_PNG_PREMULTIPLIED : OBDT_PNG_OPAQUE, &data, &size))
+        return { };
+    Vector<uint8_t> output(std::span<const uint8_t> { data, size });
+    obdt_free_encoded(data);
+    return output;
