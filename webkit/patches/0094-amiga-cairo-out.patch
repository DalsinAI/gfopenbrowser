+Path OpenFontFace::glyphPath(Glyph glyph, float size) const
+{
+    Path path;
+    Locker locker { lock() };
+    std::array<uint8_t, 256> verbBuffer;
+    std::array<int32_t, 1024> pointBuffer;
+    std::span<uint8_t> verbs { verbBuffer };
+    std::span<int32_t> points { pointBuffer };
+    Vector<uint8_t> largeVerbs;
+    Vector<int32_t> largePoints;
+    uint32_t verbCount = 0, pointCount = 0;
+    if (!obof_glyph_outline(m_face, glyph, verbs.data(), verbs.size(), points.data(), points.size() / 2, &verbCount, &pointCount)) {
+        if (verbCount <= verbs.size() && pointCount <= points.size() / 2)
+            return path;
+        largeVerbs.grow(verbCount);
+        largePoints.grow(pointCount * 2);
+        verbs = largeVerbs.mutableSpan();
+        points = largePoints.mutableSpan();
+        if (!obof_glyph_outline(m_face, glyph, verbs.data(), verbCount, points.data(), pointCount, &verbCount, &pointCount))
+            return path;
+    }
+    // the face is at a pixel size of its units per em: 26.6 font units
+    float scale = size / (64.f * m_unitsPerEm);
+    size_t point = 0;
+    auto next = [&](FloatPoint& p) -> bool {
+        if (point >= pointCount)
+            return false;
+        p = { points[point * 2] * scale, -points[point * 2 + 1] * scale };
+        ++point;
+        return true;
+    };
+    for (uint32_t i = 0; i < verbCount; ++i) {
+        FloatPoint a, b, c;
+        switch (verbs[i]) {
+        case OBOF_PATH_MOVE:
+            if (!next(a))
+                return path;
+            path.moveTo(a);
+            break;
+        case OBOF_PATH_LINE:
+            if (!next(a))
+                return path;
+            path.addLineTo(a);
+            break;
+        case OBOF_PATH_QUAD:
+            if (!next(a) || !next(b))
+                return path;
+            path.addQuadCurveTo(a, b);
+            break;
+        case OBOF_PATH_CUBIC:
+            if (!next(a) || !next(b) || !next(c))
+                return path;
+            path.addBezierCurveTo(a, b, c);
+            break;
+        case OBOF_PATH_CLOSE:
+            path.closeSubpath();
+            break;
+        }
+    }
+    return path;
+}
