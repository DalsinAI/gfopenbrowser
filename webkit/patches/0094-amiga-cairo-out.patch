+/*
+ * ShareableBitmap without cairo (patch 0083), as ShareableBitmapCairo.cpp:
+ * ARGB32 words, four bytes a pixel; drawn into and read through an
+ * AmigaImage over the bitmap's own memory, which holds a reference.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "ShareableBitmap.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "AmigaImage.h"
