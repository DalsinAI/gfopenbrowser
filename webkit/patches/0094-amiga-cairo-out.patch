+/*
+ * Path without cairo (PathAmiga.h, patch 0083).
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "PathAmiga.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "AffineTransform.h"
+#include "NullGraphicsContext.h"
+#include "FloatRoundedRect.h"
+#include "RotationDirection.h"
+#include <cmath>
+#include <numbers>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(PathAmiga);
+
+static float distanceSquared(const FloatPoint& a, const FloatPoint& b)
+{
+    float dx = b.x() - a.x(), dy = b.y() - a.y();
+    return dx * dx + dy * dy;
+}
+
+// The segments as elements only (moves, lines, curves and closes): arcs,
+// ellipses and rectangles are turned into them as they are added, as
+// cairo's path held them, so applyElements always gives the whole path.
+Ref<PathAmiga> PathAmiga::create(std::span<const PathSegment> segments)
+{
+    auto path = adoptRef(*new PathAmiga(PathStream::create()));
+    for (auto& segment : segments)
+        path->addSegment(segment);
+    return path;
+}
+
+PlatformPathPtr PathAmiga::emptyPlatformPath()
+{
+    static NeverDestroyed<Ref<PathAmiga>> empty = create();
+    return empty.get().ptr();
+}
+
+PathAmiga::PathAmiga(Ref<PathStream>&& stream)
+    : m_stream(WTF::move(stream))
+{
+}
+
+static const PathImpl& base(const Ref<PathStream>& stream)
+{
+    return stream.get();
+}
+
+static PathImpl& base(Ref<PathStream>& stream)
+{
+    return stream.get();
+}
+
+bool PathAmiga::definitelyEqual(const PathImpl& other) const
+{
+    auto* path = dynamicDowncast<PathAmiga>(other);
+    if (!path)
+        return false;
+    return path == this || base(m_stream).definitelyEqual(base(path->m_stream));
+}
+
+Ref<PathImpl> PathAmiga::copy() const
+{
+    return adoptRef(*new PathAmiga(PathStream::create(segments())));
+}
+
+void PathAmiga::add(PathMoveTo segment) { base(m_stream).add(segment); }
+void PathAmiga::add(PathLineTo segment) { base(m_stream).add(segment); }
+void PathAmiga::add(PathQuadCurveTo segment) { base(m_stream).add(segment); }
+void PathAmiga::add(PathBezierCurveTo segment) { base(m_stream).add(segment); }
+void PathAmiga::add(PathCloseSubpath segment) { base(m_stream).add(segment); }
+
+bool PathAmiga::hasCurrentPoint() const
+{
+    auto* segments = m_stream->segmentsIfExists();
+    return segments && !segments->isEmpty();
+}
+
+// An elliptical arc as cairo_arc (clockwise: the angle growing) or
+// cairo_arc_negative draws it, on an ellipse turned by rotation: a line
+// from the current point to its start (a move when there is none), then
+// cubic Beziers of at most a quarter turn each.
+void PathAmiga::addArc(const FloatPoint& center, float radiusX, float radiusY, float rotation, float startAngle, float endAngle, bool clockwise)
+{
+    constexpr double twoPi = 2 * std::numbers::pi;
+    double start = startAngle, end = endAngle;
+    if (clockwise) {
+        while (end < start)
+            end += twoPi;
+        end = std::min(end, start + twoPi);
+    } else {
+        while (end > start)
+            end -= twoPi;
+        end = std::max(end, start - twoPi);
+    }
+    double cosR = std::cos(rotation), sinR = std::sin(rotation);
+    auto point = [&](double x, double y) {
+        x *= radiusX;
+        y *= radiusY;
+        return FloatPoint(center.x() + x * cosR - y * sinR, center.y() + x * sinR + y * cosR);
+    };
+    FloatPoint first = point(std::cos(start), std::sin(start));
+    auto& stream = base(m_stream);
+    if (hasCurrentPoint())
+        stream.add(PathLineTo { first });
+    else
+        stream.add(PathMoveTo { first });
+    double sweep = end - start;
+    int pieces = std::max(1, static_cast<int>(std::ceil(std::abs(sweep) / (std::numbers::pi / 2) - 1e-6)));
+    double step = sweep / pieces;
+    double k = 4.0 / 3.0 * std::tan(step / 4);
+    double a = start;
+    for (int i = 0; i < pieces; i++, a += step) {
+        double b = a + step;
+        double ca = std::cos(a), sa = std::sin(a), cb = std::cos(b), sb = std::sin(b);
+        stream.add(PathBezierCurveTo { point(ca - k * sa, sa + k * ca), point(cb + k * sb, sb - k * cb), point(cb, sb) });
+    }
+}
+
+void PathAmiga::add(PathArc arc)
+{
+    addArc(arc.center, arc.radius, arc.radius, 0, arc.startAngle, arc.endAngle, arc.direction == RotationDirection::Clockwise);
+}
+
+void PathAmiga::add(PathClosedArc closedArc)
+{
+    add(closedArc.arc);
+    add(PathCloseSubpath { });
+}
+
+void PathAmiga::add(PathEllipse ellipse)
+{
+    addArc(ellipse.center, ellipse.radiusX, ellipse.radiusY, ellipse.rotation, ellipse.startAngle, ellipse.endAngle,
+        ellipse.direction == RotationDirection::Clockwise);
+}
+
+// As PathCairo: cairo_arc of a whole turn under the rectangle's scale
+// (after a line from the current point, if there is one, as cairo_arc).
+void PathAmiga::add(PathEllipseInRect ellipseInRect)
+{
+    auto& rect = ellipseInRect.rect;
+    float radiusX = rect.width() / 2, radiusY = rect.height() / 2;
+    addArc({ rect.x() + radiusX, rect.y() + radiusY }, radiusX, radiusY, 0, 0, 2 * std::numbers::pi_v<float>, true);
+}
+
+void PathAmiga::add(PathRect rect)
+{
+    addLinesForRect(rect.rect);
+}
+
+void PathAmiga::add(PathRoundedRect roundedRect)
+{
+    for (auto& segment : PathImpl::beziersForRoundedRect(roundedRect.roundedRect))
+        addSegment(segment);
+}
+
+// Continuous corners as plain rounded ones, as PathCairo draws them.
+void PathAmiga::add(PathContinuousRoundedRect rect)
+{
+    add(PathRoundedRect { FloatRoundedRect { rect.rect, CornerRadii { rect.cornerWidth, rect.cornerHeight } }, PathRoundedRect::Strategy::PreferNative });
+}
+
+// The canvas's arcTo, as PathCairo::add(PathArcTo) works it out: a line to
+// the first tangent point and the arc between the two lines, or a line to
+// the corner when the points are in a line or the radius is 0.
+void PathAmiga::add(PathArcTo arcTo)
+{
+    auto& stream = base(m_stream);
+    const FloatPoint p1 = arcTo.controlPoint1;
+    const FloatPoint p2 = arcTo.controlPoint2;
+    const float radius = arcTo.radius;
+    if (!hasCurrentPoint()) {
+        stream.add(PathMoveTo { p1 });
+        return;
+    }
+    const FloatPoint p0 = currentPoint();
+    float area = p0.x() * (p1.y() - p2.y()) + p1.x() * (p2.y() - p0.y()) + p2.x() * (p0.y() - p1.y());
+    if (p1 == p0 || p1 == p2 || !radius || !area) {
+        stream.add(PathLineTo { p1 });
+        return;
+    }
+    FloatPoint p1p0(p0.x() - p1.x(), p0.y() - p1.y());
+    FloatPoint p1p2(p2.x() - p1.x(), p2.y() - p1.y());
+    float p1p0Length = std::hypot(p1p0.x(), p1p0.y());
+    float p1p2Length = std::hypot(p1p2.x(), p1p2.y());
+    double cosPhi = (p1p0.x() * p1p2.x() + p1p0.y() * p1p2.y()) / (p1p0Length * p1p2Length);
+    if (cosPhi == -1) {
+        stream.add(PathLineTo { p1 });
+        return;
+    }
+    if (cosPhi == 1) {
+        double factor = 65535 / p1p0Length;
+        stream.add(PathLineTo { FloatPoint(p0.x() + factor * p1p0.x(), p0.y() + factor * p1p0.y()) });
+        return;
+    }
+    float tangent = radius / std::tan(std::acos(cosPhi) / 2);
+    float factorP1P0 = tangent / p1p0Length;
+    FloatPoint tP1P0(p1.x() + factorP1P0 * p1p0.x(), p1.y() + factorP1P0 * p1p0.y());
+    FloatPoint orthP1P0(p1p0.y(), -p1p0.x());
+    float orthP1P0Length = std::hypot(orthP1P0.x(), orthP1P0.y());
+    float factorRadius = radius / orthP1P0Length;
+    double cosAlpha = (orthP1P0.x() * p1p2.x() + orthP1P0.y() * p1p2.y()) / (orthP1P0Length * p1p2Length);
+    if (cosAlpha < 0)
+        orthP1P0 = FloatPoint(-orthP1P0.x(), -orthP1P0.y());
+    FloatPoint center(tP1P0.x() + factorRadius * orthP1P0.x(), tP1P0.y() + factorRadius * orthP1P0.y());
+    orthP1P0 = FloatPoint(-orthP1P0.x(), -orthP1P0.y());
+    float startAngle = std::acos(orthP1P0.x() / orthP1P0Length);
+    if (orthP1P0.y() < 0)
+        startAngle = 2 * std::numbers::pi_v<float> - startAngle;
+    bool clockwise = true;
+    float factorP1P2 = tangent / p1p2Length;
+    FloatPoint tP1P2(p1.x() + factorP1P2 * p1p2.x(), p1.y() + factorP1P2 * p1p2.y());
+    FloatPoint orthP1P2(tP1P2.x() - center.x(), tP1P2.y() - center.y());
+    float orthP1P2Length = std::hypot(orthP1P2.x(), orthP1P2.y());
+    float endAngle = std::acos(orthP1P2.x() / orthP1P2Length);
+    if (orthP1P2.y() < 0)
+        endAngle = 2 * std::numbers::pi_v<float> - endAngle;
+    if ((startAngle > endAngle && startAngle - endAngle < std::numbers::pi_v<float>)
+        || (startAngle < endAngle && endAngle - startAngle > std::numbers::pi_v<float>))
+        clockwise = false;
+    stream.add(PathLineTo { tP1P0 });
+    addArc(center, radius, radius, 0, startAngle, endAngle, clockwise);
+}
+
+// Another path's elements, through a transform, as lines and cubics.
+void PathAmiga::addPath(const PathAmiga& path, const AffineTransform& transform)
+{
+    auto& to = base(m_stream);
+    path.applyElements([&](const PathElement& element) {
+        auto& p = element.points;
+        switch (element.type) {
+        case PathElement::Type::MoveToPoint:
+            to.add(PathMoveTo { transform.mapPoint(p[0]) });
+            break;
+        case PathElement::Type::AddLineToPoint:
+            to.add(PathLineTo { transform.mapPoint(p[0]) });
+            break;
+        case PathElement::Type::AddQuadCurveToPoint:
+            to.add(PathQuadCurveTo { transform.mapPoint(p[0]), transform.mapPoint(p[1]) });
+            break;
+        case PathElement::Type::AddCurveToPoint:
+            to.add(PathBezierCurveTo { transform.mapPoint(p[0]), transform.mapPoint(p[1]), transform.mapPoint(p[2]) });
+            break;
+        case PathElement::Type::CloseSubpath:
+            to.add(PathCloseSubpath { });
+            break;
+        }
+    });
+}
+
+void PathAmiga::applySegments(const PathSegmentApplier& applier) const
+{
+    base(m_stream).applySegments(applier);
+}
+
+bool PathAmiga::applyElements(const PathElementApplier& applier) const
+{
+    return base(m_stream).applyElements(applier);
+}
+
+bool PathAmiga::transform(const AffineTransform& transform)
+{
+    return base(m_stream).transform(transform);
+}
+
+FloatPoint PathAmiga::currentPoint() const
+{
+    return base(m_stream).currentPoint();
+}
+
+FloatRect PathAmiga::fastBoundingRect() const
+{
+    return base(m_stream).fastBoundingRect();
+}
+
+FloatRect PathAmiga::boundingRect() const
+{
+    return base(m_stream).boundingRect();
+}
+
+bool PathAmiga::hasSubpaths() const
+{
+    return base(m_stream).hasSubpaths();
+}
+
+bool PathAmiga::isClosed() const
+{
+    return base(m_stream).isClosed();
+}
+
+// Curves cut into lines: as many as keep each within about a quarter pixel
+// of the curve (by the control points' distance), 1 to 64.
+static unsigned linesFor(float span)
+{
+    float n = std::ceil(std::sqrt(std::max(span, 0.0f) * 2));
+    return static_cast<unsigned>(std::clamp(n, 1.0f, 64.0f));
+}
+
+void PathAmiga::flatten(const Function<void(const FloatPoint&, const FloatPoint&, bool)>& line) const
+{
+    FloatPoint start, current;
+    bool first = true;
+    auto lineTo = [&](const FloatPoint& point) {
+        line(current, point, first);
+        first = false;
+        current = point;
+    };
+    applyElements([&](const PathElement& element) {
+        auto& p = element.points;
+        switch (element.type) {
+        case PathElement::Type::MoveToPoint:
+            start = current = p[0];
+            first = true;
+            break;
+        case PathElement::Type::AddLineToPoint:
+            lineTo(p[0]);
+            break;
+        case PathElement::Type::AddQuadCurveToPoint: {
+            FloatPoint p0 = current;
+            unsigned n = linesFor(std::sqrt(std::max(distanceSquared(p0, p[0]), distanceSquared(p[0], p[1]))));
+            for (unsigned i = 1; i <= n; i++) {
+                float t = static_cast<float>(i) / n, u = 1 - t;
+                lineTo({ u * u * p0.x() + 2 * u * t * p[0].x() + t * t * p[1].x(), u * u * p0.y() + 2 * u * t * p[0].y() + t * t * p[1].y() });
+            }
+            break;
+        }
+        case PathElement::Type::AddCurveToPoint: {
+            FloatPoint p0 = current;
+            float span = std::sqrt(std::max(distanceSquared(p0, p[0]), std::max(distanceSquared(p[0], p[1]), distanceSquared(p[1], p[2]))));
+            unsigned n = linesFor(span);
+            for (unsigned i = 1; i <= n; i++) {
+                float t = static_cast<float>(i) / n, u = 1 - t;
+                float a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
+                lineTo({ a * p0.x() + b * p[0].x() + c * p[1].x() + d * p[2].x(), a * p0.y() + b * p[0].y() + c * p[1].y() + d * p[2].y() });
+            }
+            break;
+        }
+        case PathElement::Type::CloseSubpath:
+            if (current != start || first)
+                lineTo(start);
+            current = start;
+            break;
+        }
+    });
+}
+
+// The point's winding: every subpath taken as closed, as a fill takes it.
+bool PathAmiga::contains(const FloatPoint& point, WindRule rule) const
+{
+    if (!fastBoundingRect().contains(point))
+        return false;
+    int winding = 0;
+    FloatPoint subpathStart, last;
+    bool open = false;
+    auto edge = [&](const FloatPoint& a, const FloatPoint& b) {
+        if (a.y() <= point.y()) {
+            if (b.y() > point.y() && (b.x() - a.x()) * (point.y() - a.y()) - (point.x() - a.x()) * (b.y() - a.y()) > 0)
+                winding++;
+        } else if (b.y() <= point.y() && (b.x() - a.x()) * (point.y() - a.y()) - (point.x() - a.x()) * (b.y() - a.y()) < 0)
+            winding--;
+    };
+    flatten([&](const FloatPoint& a, const FloatPoint& b, bool startsSubpath) {
+        if (startsSubpath) {
+            if (open && last != subpathStart)
+                edge(last, subpathStart);
+            subpathStart = a;
+            open = true;
+        }
+        edge(a, b);
+        last = b;
+    });
+    if (open && last != subpathStart)
+        edge(last, subpathStart);
+    return rule == WindRule::EvenOdd ? (winding & 1) : winding;
+}
+
+static float strokeWidthFor(const Function<void(GraphicsContext&)>& strokeStyleApplier)
+{
+    NullGraphicsContext context;
+    if (strokeStyleApplier)
+        strokeStyleApplier(context);
+    return context.strokeThickness();
+}
+
+// Within half the stroke's width of a line of the path (caps and joins as
+// round ones: under half a width off at a miter).
+bool PathAmiga::strokeContains(const FloatPoint& point, const Function<void(GraphicsContext&)>& strokeStyleApplier) const
+{
+    float half = strokeWidthFor(strokeStyleApplier) / 2;
+    if (!(half > 0))
+        return false;
+    float limit = half * half;
+    bool hit = false;
+    flatten([&](const FloatPoint& a, const FloatPoint& b, bool) {
+        if (hit)
+            return;
+        float dx = b.x() - a.x(), dy = b.y() - a.y();
+        float length = dx * dx + dy * dy;
+        float t = length > 0 ? std::clamp(((point.x() - a.x()) * dx + (point.y() - a.y()) * dy) / length, 0.0f, 1.0f) : 0;
+        float px = a.x() + t * dx - point.x(), py = a.y() + t * dy - point.y();
+        hit = px * px + py * py <= limit;
+    });
+    return hit;
+}
+
+FloatRect PathAmiga::strokeBoundingRect(const Function<void(GraphicsContext&)>& strokeStyleApplier) const
+{
+    FloatRect rect = boundingRect();
+    float half = strokeWidthFor(strokeStyleApplier) / 2;
+    // a miter of the default limit (10) reaches 5 widths out; square caps sqrt 2 halves
+    if (half > 0)
+        rect.inflate(half * 1.5f);
+    return rect;
+}
+
+} // namespace WebCore
+
+#endif // USE(AMIGA_GRAPHICS)
