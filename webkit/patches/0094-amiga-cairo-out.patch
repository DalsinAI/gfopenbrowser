+}
+
+Path Font::platformPathForGlyph(Glyph glyph) const
+{
+    auto* face = platformData().openFontFace();
+    if (!face || !platformData().size())
+        return { };
+    Path path = face->glyphPath(glyph, platformData().size());
+    if (float offset = syntheticBoldOffset()) {
+        Path bold = face->glyphPath(glyph, platformData().size());
+        path.addPath(bold, AffineTransform::makeTranslation({ offset, 0 }));
+    }
+    return path;
+}
+
+// The ink box as cairo's glyph extents gave it: the face's box at the size.
+FloatRect Font::platformBoundsForGlyph(Glyph glyph) const
+{
+    auto* face = m_platformData.openFontFace();
+    if (!face || !m_platformData.size())
+        return FloatRect();
+    FloatRect bounds;
+    if (!face->glyphBounds(glyph, bounds))
+        return FloatRect();
+    bounds.scale(m_platformData.size() / face->unitsPerEm());
+    return bounds;
+}
+
+float Font::platformWidthForGlyph(Glyph glyph) const
+{
+    auto* face = m_platformData.openFontFace();
+    if (!face || !m_platformData.size())
+        return 0;
+    float width = face->hintedAdvance(glyph, m_platformData.size());
+    return width ? width : m_spaceWidth;
+}
+
+ResolvedEmojiPolicy FontCascade::resolveEmojiPolicy(FontVariantEmoji fontVariantEmoji, char32_t)
+{
+    switch (fontVariantEmoji) {
+    case FontVariantEmoji::Normal:
+    case FontVariantEmoji::Unicode:
+        return ResolvedEmojiPolicy::NoPreference;
+    case FontVariantEmoji::Text:
+        return ResolvedEmojiPolicy::RequireText;
+    case FontVariantEmoji::Emoji:
+        return ResolvedEmojiPolicy::RequireEmoji;
+    }
+    return ResolvedEmojiPolicy::NoPreference;
+}
