diff --git a/Source/WebCore/platform/graphics/amiga/AmigaImage.cpp b/Source/WebCore/platform/graphics/amiga/AmigaImage.cpp
new file mode 100644
index 00000000..6fe4421b
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/AmigaImage.cpp
@@ -0,0 +1,74 @@
+/*
+ * The engine's picture without cairo (AmigaImage.h, patch 0083).
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "AmigaImage.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include <atomic>
+#include <string.h>
+#include <wtf/CheckedArithmetic.h>
+#include <wtf/FastMalloc.h>
+
+namespace WebCore {
+
+static uint64_t nextUniqueID()
+{
+    static std::atomic<uint64_t> next { 1 };
+    return next++;
+}
+
+AmigaImage::AmigaImage(uint8_t* data, const IntSize& size, unsigned stride, bool hasAlpha, Function<void()>&& release)
+    : m_data(data)
+    , m_size(size)
+    , m_stride(stride)
+    , m_hasAlpha(hasAlpha)
+    , m_uniqueID(nextUniqueID())
+    , m_release(WTF::move(release))
+{
+}
+
+AmigaImage::~AmigaImage()
+{
+    if (m_release)
+        m_release();
+}
+
+RefPtr<AmigaImage> AmigaImage::create(const IntSize& size, bool hasAlpha)
+{
+    if (size.isEmpty())
+        return nullptr;
+    CheckedSize stride = CheckedSize(static_cast<size_t>(size.width())) * static_cast<size_t>(4);
+    CheckedSize bytes = stride * static_cast<size_t>(size.height());
+    if (bytes.hasOverflowed() || stride.value() > 0x7fffffff)
+        return nullptr;
+    void* data = nullptr;
+    if (!tryFastCalloc(bytes.value(), 1).getValue(data))
+        return nullptr;
+    return adoptRef(*new AmigaImage(static_cast<uint8_t*>(data), size, static_cast<unsigned>(stride.value()), hasAlpha, [data] {
+        fastFree(data);
+    }));
+}
+
+Ref<AmigaImage> AmigaImage::wrap(uint8_t* data, const IntSize& size, unsigned stride, bool hasAlpha, Function<void()>&& release)
+{
+    return adoptRef(*new AmigaImage(data, size, stride, hasAlpha, WTF::move(release)));
+}
+
+RefPtr<AmigaImage> AmigaImage::copy() const
+{
+    auto image = create(m_size, m_hasAlpha);
+    if (!image)
+        return nullptr;
+    size_t row = static_cast<size_t>(m_size.width()) * 4;
+    for (int y = 0; y < m_size.height(); y++)
+        memcpy(image->row(y), this->row(y), row);
+    return image;
+}
+
+} // namespace WebCore
+
+#endif // USE(AMIGA_GRAPHICS)
diff --git a/Source/WebCore/platform/graphics/amiga/AmigaImage.h b/Source/WebCore/platform/graphics/amiga/AmigaImage.h
new file mode 100644
index 00000000..682121cb
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/AmigaImage.h
@@ -0,0 +1,59 @@
+/*
+ * The engine's picture without cairo (patch 0083): premultiplied ARGB32
+ * pixels, one 32-bit word each in the CPU's order (on the 68k A, R, G, B
+ * in memory, as cairo's CAIRO_FORMAT_ARGB32 and OpenGPU's OBGPU_ARGB), or
+ * the same with the alpha ignored (opaque, cairo's RGB24). The pixels are
+ * the picture's own, or someone else's held until the last reference goes
+ * (a decoder's frame, a PixelBuffer). NativeImage's PlatformImagePtr.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "IntSize.h"
+#include <wtf/Function.h>
+#include <wtf/ThreadSafeRefCounted.h>
+
+namespace WebCore {
+
+class AmigaImage : public ThreadSafeRefCounted<AmigaImage> {
+    WTF_MAKE_NONCOPYABLE(AmigaImage);
+public:
+    // New pixels, cleared to transparent black; null when there is no memory.
+    static RefPtr<AmigaImage> create(const IntSize&, bool hasAlpha = true);
+    // Someone else's pixels: release runs when the last reference goes.
+    static Ref<AmigaImage> wrap(uint8_t* data, const IntSize&, unsigned stride, bool hasAlpha, Function<void()>&& release);
+
+    ~AmigaImage();
+
+    uint8_t* data() const { return m_data; }
+    unsigned stride() const { return m_stride; }
+    const IntSize& size() const { return m_size; }
+    int width() const { return m_size.width(); }
+    int height() const { return m_size.height(); }
+    bool hasAlpha() const { return m_hasAlpha; }
+    uint32_t* row(int y) const { return reinterpret_cast<uint32_t*>(m_data + static_cast<size_t>(y) * m_stride); }
+    std::span<const uint8_t> span() const { return { m_data, static_cast<size_t>(m_stride) * m_size.height() }; }
+    std::span<uint8_t> mutableSpan() { return { m_data, static_cast<size_t>(m_stride) * m_size.height() }; }
+    // A number no other picture has had (display lists, caches).
+    uint64_t uniqueID() const { return m_uniqueID; }
+
+    // A copy with pixels of its own.
+    RefPtr<AmigaImage> copy() const;
+
+private:
+    AmigaImage(uint8_t* data, const IntSize&, unsigned stride, bool hasAlpha, Function<void()>&& release);
+
+    uint8_t* m_data;
+    IntSize m_size;
+    unsigned m_stride;
+    bool m_hasAlpha;
+    uint64_t m_uniqueID;
+    Function<void()> m_release;
+};
+
+} // namespace WebCore
+
+#endif // USE(AMIGA_GRAPHICS)
