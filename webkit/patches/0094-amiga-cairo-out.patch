+CheckedUint32 ShareableBitmapConfiguration::calculateBytesPerRow(const IntSize& size, PixelFormat, const ColorSpace&)
+{
+    return CheckedUint32(size.width()) * 4;
+}
+
+// The bitmap's pixels as a picture, holding the bitmap until it goes.
+static Ref<AmigaImage> imageOf(ShareableBitmap& bitmap)
+{
+    bitmap.ref();
+    auto* owner = &bitmap;
+    return AmigaImage::wrap(bitmap.mutableSpan().data(), bitmap.size(), bitmap.size().width() * 4, true, [owner] {
+        owner->deref();
+    });
+}
+
+namespace {
+// A context over the bitmap that keeps its picture (and so the bitmap) alive.
+class ShareableBitmapContext final : public GraphicsContextOpenGPU {
+public:
+    explicit ShareableBitmapContext(Ref<AmigaImage>&& image)
+        : GraphicsContextOpenGPU(image.get(), nullptr)
+        , m_image(WTF::move(image))
+    {
+    }
+private:
+    Ref<AmigaImage> m_image;
+};
+}
+
+std::unique_ptr<GraphicsContext> ShareableBitmap::createGraphicsContext()
+{
+    return makeUnique<ShareableBitmapContext>(imageOf(*this));
+}
+
+void ShareableBitmap::paint(GraphicsContext& context, const IntPoint& dstPoint, const IntRect& srcRect)
+{
+    paint(context, 1, dstPoint, srcRect);
+}
+
+void ShareableBitmap::paint(GraphicsContext& context, float scaleFactor, const IntPoint& dstPoint, const IntRect& srcRect)
+{
+    PlatformImagePtr picture = imageOf(*this);
+    auto image = NativeImage::create(WTF::move(picture));
+    if (!image)
+        return;
+    FloatRect source(srcRect);
+    source.scale(scaleFactor);
+    context.drawNativeImage(*image, FloatRect(dstPoint, srcRect.size()), source);
+}
+
+PlatformImagePtr ShareableBitmap::createBasePlatformImage(BackingStoreCopy copyBehavior, ShouldInterpolate)
+{
+    auto image = imageOf(*this);
+    if (copyBehavior == CopyBackingStore)
+        return image->copy();
+    return image;
+}
+
+PlatformImagePtr ShareableBitmap::createPlatformImage(BackingStoreCopy copyBehavior, ShouldInterpolate shouldInterpolate)
+{
+    return createBasePlatformImage(copyBehavior, shouldInterpolate);
+}
+
+RefPtr<BitmapImage> ShareableBitmap::createImage()
+{
+    return BitmapImage::create(createBasePlatformImage(DontCopyBackingStore));
+}
