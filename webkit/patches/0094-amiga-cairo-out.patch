diff --git a/Source/WebCore/platform/graphics/amiga/ImageBufferAmigaBackend.cpp b/Source/WebCore/platform/graphics/amiga/ImageBufferAmigaBackend.cpp
new file mode 100644
index 00000000..60830b45
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/ImageBufferAmigaBackend.cpp
@@ -0,0 +1,204 @@
+/*
+ * An ImageBuffer without cairo (ImageBufferAmigaBackend.h, patch 0083).
+ *
+ * WebKit's pixel copies (ImageBufferBackend::getPixelBuffer and
+ * putPixelBuffer) read and write BGRA8 bytes: B, G, R, A in memory. Our
+ * pixels are ARGB32 words, which are those bytes only on a little-endian
+ * CPU; on the 68k each copy goes through BGRA8 rows of its own.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "ImageBufferAmigaBackend.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "Color.h"
+#include "ColorTransferFunctions.h"
+#include "GraphicsContextOpenGPU.h"
+#include "ImageBuffer.h"
+#include "NativeImage.h"
+#include "PixelBuffer.h"
+#include <wtf/CheckedArithmetic.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/Vector.h>
+#include <wtf/text/TextStream.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(ImageBufferAmigaBackend);
+
+// as cairo's image surfaces: 32767 pixels a side
+static constexpr int maxImageSide = 32767;
+
+IntSize ImageBufferAmigaBackend::calculateSafeBackendSize(const ImageBufferParameters& parameters)
+{
+    IntSize backendSize = parameters.backendSize();
+    if (backendSize.isEmpty() || backendSize.width() > maxImageSide || backendSize.height() > maxImageSide)
+        return { };
+    CheckedSize bytes = CheckedSize(static_cast<size_t>(backendSize.height())) * static_cast<size_t>(backendSize.width()) * static_cast<size_t>(4);
+    if (bytes.hasOverflowed())
+        return { };
+    return backendSize;
+}
+
+unsigned ImageBufferAmigaBackend::calculateBytesPerRow(const IntSize& backendSize)
+{
+    return backendSize.width() * 4;
+}
+
+std::unique_ptr<ImageBufferAmigaBackend> ImageBufferAmigaBackend::create(const ImageBufferParameters& parameters, const ImageBufferCreationContext&)
+{
+    IntSize backendSize = calculateSafeBackendSize(parameters);
+    if (backendSize.isEmpty())
+        return nullptr;
+    auto image = AmigaImage::create(backendSize);
+    if (!image)
+        return nullptr;
+    return std::unique_ptr<ImageBufferAmigaBackend>(new ImageBufferAmigaBackend(parameters, image.releaseNonNull()));
+}
+
+std::unique_ptr<ImageBufferAmigaBackend> ImageBufferAmigaBackend::create(const ImageBufferParameters& parameters, const GraphicsContext&)
+{
+    return create(parameters, ImageBufferCreationContext { });
+}
+
+ImageBufferAmigaBackend::ImageBufferAmigaBackend(const ImageBufferParameters& parameters, Ref<AmigaImage>&& image)
+    : ImageBufferBackend(parameters)
+    , m_image(WTF::move(image))
+    , m_context(makeUnique<GraphicsContextOpenGPU>(m_image.get(), nullptr))
+{
+    m_context->applyDeviceScaleFactor(parameters.resolutionScale);
+}
+
+ImageBufferAmigaBackend::~ImageBufferAmigaBackend() = default;
+
+GraphicsContext& ImageBufferAmigaBackend::context()
+{
+    return *m_context;
+}
+
+// the batch drawn: whoever reads the pixels next sees all of it
+void ImageBufferAmigaBackend::flushContext()
+{
+    m_context->flushBatch();
+}
+
+RefPtr<NativeImage> ImageBufferAmigaBackend::copyNativeImage()
+{
+    flushContext();
+    PlatformImagePtr copy = m_image->copy();
+    if (!copy)
+        return nullptr;
+    return NativeImage::create(WTF::move(copy));
+}
+
+RefPtr<NativeImage> ImageBufferAmigaBackend::createNativeImageReference()
+{
+    flushContext();
+    PlatformImagePtr image = m_image.ptr();
+    return NativeImage::create(WTF::move(image));
+}
+
+void ImageBufferAmigaBackend::transformToColorSpace(const ColorSpace& newColorSpace)
+{
+    if (m_colorSpace == newColorSpace)
+        return;
+    // only sRGB <-> linearRGB, as ImageBufferCairoBackend
+    if ((m_colorSpace != ColorSpace::LinearSRGB() && m_colorSpace != ColorSpace::SRGB())
+        || (newColorSpace != ColorSpace::LinearSRGB() && newColorSpace != ColorSpace::SRGB()))
+        return;
+    m_colorSpace = newColorSpace;
+    auto table = [](bool toLinear) {
+        std::array<uint8_t, 256> array;
+        for (unsigned i = 0; i < 256; i++) {
+            float color = i / 255.0f;
+            color = toLinear ? SRGBTransferFunction<float, TransferFunctionMode::Clamped>::toLinear(color)
+                : SRGBTransferFunction<float, TransferFunctionMode::Clamped>::toGammaEncoded(color);
+            array[i] = static_cast<uint8_t>(round(color * 255));
+        }
+        return array;
+    };
+    static const std::array<uint8_t, 256> linearTable = table(true);
+    static const std::array<uint8_t, 256> deviceTable = table(false);
+    auto& lookUpTable = newColorSpace == ColorSpace::LinearSRGB() ? linearTable : deviceTable;
+    flushContext();
+    for (int y = 0; y < m_image->height(); ++y) {
+        uint32_t* row = m_image->row(y);
+        for (int x = 0; x < m_image->width(); x++) {
+            auto c = unpremultiplied(asSRGBA(PackedColor::ARGB { row[x] })).resolved();
+            SRGBA<uint8_t> t { lookUpTable[c.red], lookUpTable[c.green], lookUpTable[c.blue], c.alpha };
+            row[x] = PackedColor::ARGB { premultipliedCeiling(t) }.value;
+        }
+    }
+}
+
+#if CPU(BIG_ENDIAN)
+// ARGB32 words to and from BGRA8 bytes: each word's bytes reversed.
+static inline uint32_t reversed(uint32_t word)
+{
+    return __builtin_bswap32(word);
+}
+
+static void reverseRows(const AmigaImage& from, uint8_t* to, unsigned toStride, int y0, int y1)
+{
+    for (int y = y0; y < y1; y++) {
+        const uint32_t* source = from.row(y);
+        uint32_t* destination = reinterpret_cast<uint32_t*>(to + static_cast<size_t>(y) * toStride);
+        for (int x = 0; x < from.width(); x++)
+            destination[x] = reversed(source[x]);
+    }
+}
+#endif
+
+void ImageBufferAmigaBackend::getPixelBuffer(const IntRect& srcRect, PixelBuffer& destination)
+{
+    flushContext();
+#if CPU(BIG_ENDIAN)
+    // BGRA8 rows of the rectangle's rows only; the others are not read
+    IntRect rows = intersection(srcRect, IntRect(IntPoint(), m_image->size()));
+    Vector<uint8_t> bytes;
+    if (!bytes.tryGrow(m_image->span().size()))
+        return;
+    if (!rows.isEmpty())
+        reverseRows(m_image.get(), bytes.mutableSpan().data(), m_image->stride(), rows.y(), rows.maxY());
+    ImageBufferBackend::getPixelBuffer(srcRect, bytes.span(), destination);
+#else
+    ImageBufferBackend::getPixelBuffer(srcRect, m_image->span(), destination);
+#endif
+}
+
+void ImageBufferAmigaBackend::putPixelBuffer(const PixelBufferSourceView& pixelBuffer, const IntRect& srcRect, const IntPoint& destPoint, AlphaPremultiplication destFormat)
+{
+    flushContext();
+#if CPU(BIG_ENDIAN)
+    IntRect rows = intersection(IntRect(destPoint, srcRect.size()), IntRect(IntPoint(), m_image->size()));
+    if (rows.isEmpty())
+        return;
+    Vector<uint8_t> bytes;
+    if (!bytes.tryGrow(m_image->span().size()))
+        return;
+    // the rows it writes, as BGRA8, so pixels it leaves stay as they were
+    reverseRows(m_image.get(), bytes.mutableSpan().data(), m_image->stride(), rows.y(), rows.maxY());
+    ImageBufferBackend::putPixelBuffer(pixelBuffer, srcRect, destPoint, destFormat, bytes.mutableSpan());
+    for (int y = rows.y(); y < rows.maxY(); y++) {
+        const uint32_t* source = reinterpret_cast<const uint32_t*>(bytes.span().data() + static_cast<size_t>(y) * m_image->stride());
+        uint32_t* row = m_image->row(y);
+        for (int x = rows.x(); x < rows.maxX(); x++)
+            row[x] = reversed(source[x]);
+    }
+#else
+    ImageBufferBackend::putPixelBuffer(pixelBuffer, srcRect, destPoint, destFormat, m_image->mutableSpan());
+#endif
+}
+
+String ImageBufferAmigaBackend::debugDescription() const
+{
+    TextStream stream;
+    stream << "ImageBufferAmigaBackend " << this << " " << m_image->size();
+    return stream.release();
+}
+
+} // namespace WebCore
+
+#endif // USE(AMIGA_GRAPHICS)
