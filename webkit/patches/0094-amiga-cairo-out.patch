@@ -0,0 +1,55 @@
+/*
+ * An ImageBuffer without cairo (patch 0083): an AmigaImage's pixels, drawn
+ * into by a GraphicsContextOpenGPU (canvas, filters, layers, pictures the
+ * engine makes). In place of ImageBufferCairoImageSurfaceBackend.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "AmigaImage.h"
+#include "ImageBufferBackend.h"
+#include <wtf/TZoneMalloc.h>
+
+namespace WebCore {
+
+class GraphicsContextOpenGPU;
+
+class ImageBufferAmigaBackend final : public ImageBufferBackend {
+    WTF_MAKE_TZONE_ALLOCATED(ImageBufferAmigaBackend);
+    WTF_MAKE_NONCOPYABLE(ImageBufferAmigaBackend);
+public:
+    static IntSize calculateSafeBackendSize(const ImageBufferParameters&);
+    static unsigned calculateBytesPerRow(const IntSize& backendSize);
+    size_t memoryCost() const final { return ImageBufferBackend::calculateMemoryCost(size(), calculateBytesPerRow(size())); }
+
+    static std::unique_ptr<ImageBufferAmigaBackend> create(const ImageBufferParameters&, const ImageBufferCreationContext&);
+    static std::unique_ptr<ImageBufferAmigaBackend> create(const ImageBufferParameters&, const GraphicsContext&);
+    ~ImageBufferAmigaBackend();
+
+    GraphicsContext& context() final;
+    void flushContext() final;
+    RefPtr<NativeImage> copyNativeImage() final;
+    RefPtr<NativeImage> createNativeImageReference() final;
+    bool canMapBackingStore() const final { return true; }
+    void transformToColorSpace(const ColorSpace&) final;
+    void getPixelBuffer(const IntRect&, PixelBuffer&) final;
+    void putPixelBuffer(const PixelBufferSourceView&, const IntRect& srcRect, const IntPoint& destPoint, AlphaPremultiplication destFormat) final;
+
+private:
+    ImageBufferAmigaBackend(const ImageBufferParameters&, Ref<AmigaImage>&&);
+    unsigned bytesPerRow() const final { return m_image->stride(); }
+    String debugDescription() const final;
+
+    const Ref<AmigaImage> m_image;
+    std::unique_ptr<GraphicsContextOpenGPU> m_context;
+};
+
+using ImageBufferPlatformBackend = ImageBufferAmigaBackend;
+using ImageBufferPlatformBitmapBackend = ImageBufferAmigaBackend;
+
+} // namespace WebCore
+
+#endif // USE(AMIGA_GRAPHICS)
diff --git a/Source/WebCore/platform/graphics/amiga/NativeImageAmiga.cpp b/Source/WebCore/platform/graphics/amiga/NativeImageAmiga.cpp
new file mode 100644
index 00000000..ed136090
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/NativeImageAmiga.cpp
@@ -0,0 +1,121 @@
+/*
+ * NativeImage on the engine's own pictures (AmigaImage, patch 0083), as
+ * NativeImageCairo.cpp did on cairo's image surfaces: premultiplied ARGB32
+ * words, or opaque ones whose alpha is ignored.
+ * MIT, Copyright (c) 2026 AmiCradle Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "NativeImage.h"
+
+#if USE(AMIGA_GRAPHICS)
+
+#include "Color.h"
+#include "NotImplemented.h"
+#include "PixelBuffer.h"
+#include <algorithm>
+
+namespace WebCore {
+
+RefPtr<NativeImage> NativeImage::create(Ref<PixelBuffer>&& pixelBuffer)
+{
+    if (pixelBuffer->size().isEmpty())
+        return nullptr;
+    auto format = pixelBuffer->format();
+    bool hasAlpha = !pixelFormatIsOpaque(format.pixelFormat);
+    // Our pixels are 32-bit words A R G B, the bytes A, R, G, B on the 68k
+    // (big-endian): BGRA8 is that order on a little-endian CPU only.
+    enum class Order { RGBA, BGRA } order;
+    switch (format.pixelFormat) {
+    case PixelFormat::RGBX8:
+    case PixelFormat::RGBA8:
+        order = Order::RGBA;
+        break;
+    case PixelFormat::BGRX8:
+    case PixelFormat::BGRA8:
+        order = Order::BGRA;
+        break;
+    default:
+        return nullptr;
+    }
+    size_t totalBytes = pixelBuffer->bytes().size();
+    uint8_t* pixels = pixelBuffer->bytes().data();
+    bool premultiply = hasAlpha && format.alphaFormat == AlphaPremultiplication::Unpremultiplied;
+    for (size_t i = 0; i + 3 < totalBytes; i += 4) {
+        uint8_t r, g, b, a = pixels[i + 3];
+        if (order == Order::RGBA) {
+            r = pixels[i];
+            g = pixels[i + 1];
+            b = pixels[i + 2];
+        } else {
+            b = pixels[i];
+            g = pixels[i + 1];
+            r = pixels[i + 2];
+        }
+        if (premultiply) {
+            r = std::min(255, r * a / 255);
+            g = std::min(255, g * a / 255);
+            b = std::min(255, b * a / 255);
+        }
+        uint32_t word = static_cast<uint32_t>(hasAlpha ? a : 255) << 24 | static_cast<uint32_t>(r) << 16 | static_cast<uint32_t>(g) << 8 | b;
+        *reinterpret_cast<uint32_t*>(pixels + i) = word;
+    }
+    auto size = pixelBuffer->size();
+    auto* buffer = pixelBuffer.ptr();
+    SUPPRESS_RETAINPTR_CTOR_ADOPT (void) pixelBuffer.leakRef(); // NOLINT
+    PlatformImagePtr image = AmigaImage::wrap(pixels, size, size.width() * 4, hasAlpha, [buffer] {
+        buffer->deref();
+    });
+    return create(WTF::move(image));
+}
+
+IntSize NativeImage::size() const
+{
+    Locker locker { m_lock };
+    return m_platformImage ? m_platformImage->size() : IntSize();
+}
+
+bool NativeImage::hasAlpha() const
+{
+    Locker locker { m_lock };
+    return m_platformImage && m_platformImage->hasAlpha();
+}
+
+ColorSpace NativeImage::colorSpace() const
+{
+    return ColorSpace::SRGB();
+}
+
+NativeImage::UnpremultipliedPixels NativeImage::unpremultipliedPixels() const
+{
+    // premultiplied by definition, as cairo's ARGB32
+    return { };
+}
+
+std::optional<Color> NativeImage::singlePixelSolidColor() const
+{
+    if (size() != IntSize(1, 1))
+        return std::nullopt;
+    Locker locker { m_lock };
+    uint32_t pixel = *m_platformImage->row(0);
+    if (!m_platformImage->hasAlpha())
+        pixel |= 0xff000000;
+    return unpremultiplied(asSRGBA(PackedColor::ARGB { pixel }));
+}
+
+void NativeImage::clearSubimages()
+{
+}
+
+#if USE(COORDINATED_GRAPHICS)
+uint64_t NativeImage::uniqueID() const
+{
+    if (auto image = platformImage())
+        return image->uniqueID();
+    return 0;
+}
+#endif
+
