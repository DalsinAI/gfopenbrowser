+
+#include "config.h"
+#include "AmigaScriptBytecode.h"
+
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <wtf/MallocSpan.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+static Lock folderLock;
+
+static String& folder() WTF_REQUIRES_LOCK(folderLock)
+{
+    static NeverDestroyed<String> path;
+    return path;
+}
+
+void setAmigaScriptBytecodeFolder(const String& path)
+{
+    Locker locker { folderLock };
+    folder() = path.isolatedCopy();
+    if (!path.isEmpty()) {
+        auto utf8 = path.utf8();
+        mkdir(reinterpret_cast<const char*>(utf8.data()), 0777);
+    }
+}
+
+// FNV-1a over the text's code units, with its length beside it in the name:
+// two texts share a file only if both match (and JavaScriptCore checks the
+// text's own hash and length again when it decodes).
+static uint32_t textHash(StringView text)
+{
+    uint32_t h = 2166136261u;
+    for (unsigned i = 0; i < text.length(); i++) {
+        char16_t c = text[i];
+        h = (h ^ (c & 0xff)) * 16777619u;
+        h = (h ^ (c >> 8)) * 16777619u;
+    }
+    return h;
+}
+
+AmigaScriptBytecode::~AmigaScriptBytecode()
+{
+    commit();
+}
+
+RefPtr<JSC::CachedBytecode> AmigaScriptBytecode::cachedBytecode(StringView source) const
+{
+    Locker locker { m_lock };
+    if (m_loaded)
+        return m_bytecode;
+    m_loaded = true;
+    String dir;
+    {
+        Locker folderLocker { folderLock };
+        dir = folder().isolatedCopy();
+    }
+    if (dir.isEmpty() || source.length() < 1024)
+        return nullptr;     // nothing kept, or a script too short to be worth a file
+    auto separator = dir.endsWith('/') || dir.endsWith(':') ? ""_s : "/"_s;
+    char name[24];
+    snprintf(name, sizeof name, "%08lx-%08lx.jsc", static_cast<unsigned long>(textHash(source)), static_cast<unsigned long>(source.length()));
+    m_path = makeString(dir, separator, String::fromLatin1(name));
+    auto utf8Path = m_path.utf8();
+    FILE* file = fopen(reinterpret_cast<const char*>(utf8Path.data()), "rb");
+    if (!file)
+        return nullptr;
+    long size = -1;
+    if (!fseek(file, 0, SEEK_END))
+        size = ftell(file);
+    if (size > 0 && !fseek(file, 0, SEEK_SET)) {
+        auto data = MallocSpan<uint8_t, JSC::VMMalloc>::tryMalloc(size);
+        if (data && fread(data.mutableSpan().data(), 1, size, file) == static_cast<size_t>(size))
+            m_bytecode = JSC::CachedBytecode::create(WTF::move(data), { });
+    }
+    fclose(file);
+    return m_bytecode;
+}
+
+// Only called when the script was made afresh: no file, or one from another
+// engine version. Either way the file is written anew.
+void AmigaScriptBytecode::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    Locker locker { m_lock };
+    if (m_path.isEmpty())
+        return;
+    m_bytecode = JSC::CachedBytecode::create();
+    if (auto update = generator())
+        m_bytecode->addGlobalUpdate(*update);
+}
+
+void AmigaScriptBytecode::updateCache(const JSC::UnlinkedFunctionExecutable* executable, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    Locker locker { m_lock };
+    if (!m_bytecode)
+        return;
+    JSC::BytecodeCacheError error;
+    RefPtr<JSC::CachedBytecode> function = JSC::encodeFunctionCodeBlock(executable->vm(), codeBlock, error);
+    if (function && !error.isValid())
+        m_bytecode->addFunctionUpdate(executable, kind, *function);
+}
+
+void AmigaScriptBytecode::commit() const
+{
+    RefPtr<JSC::CachedBytecode> bytecode;
+    String pathString;
+    {
+        Locker locker { m_lock };
+        if (!m_bytecode || !m_bytecode->hasUpdates())
+            return;
+        bytecode = std::exchange(m_bytecode, nullptr); // what is written is not added to again
+        pathString = m_path.isolatedCopy();
+    }
+    auto utf8Path = pathString.utf8();
+    const char* path = reinterpret_cast<const char*>(utf8Path.data());
+    size_t had = bytecode->size();
+    FILE* file = fopen(path, had ? "r+b" : "wb");
+    if (!file)
+        return;
+    // The file must still be the one read: another task may have written it.
+    if (had && (fseek(file, 0, SEEK_END) || static_cast<size_t>(ftell(file)) != had)) {
+        fclose(file);
+        return;
+    }
+    bool ok = true;
+    bytecode->commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (ok && (fseek(file, static_cast<long>(offset), SEEK_SET) || fwrite(data.data(), 1, data.size(), file) != data.size()))
+            ok = false;
+    });
+    if (fclose(file) || !ok)
+        remove(path); // half a file is no file
+}
+
+} // namespace WebCore
