+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "AmigaScriptBytecode.h"
+
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <wtf/Deque.h>
+#include <wtf/HashSet.h>
+#include <wtf/MallocSpan.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+static Lock folderLock;
+
+static String& folder() WTF_REQUIRES_LOCK(folderLock)
+{
+    static NeverDestroyed<String> path;
+    return path;
+}
+
+static String inFolder(const String& dir, ASCIILiteral name)
+{
+    auto separator = dir.endsWith('/') || dir.endsWith(':') ? ""_s : "/"_s;
+    return makeString(dir, separator, name);
+}
+
+// A script is kept only the second time its text runs: a page visited once
+// costs no writes. The names of the scripts seen once are in the folder's
+// "seen" file (one a line, the newest 4096), read when first needed and
+// written after the scripts (writeAmigaScriptBytecode()).
+static constexpr size_t maxSeen = 4096;
+static bool seenLoaded WTF_GUARDED_BY_LOCK(folderLock) { false };
+static bool seenChanged WTF_GUARDED_BY_LOCK(folderLock) { false };
+
+static Vector<String>& seenOrder() WTF_REQUIRES_LOCK(folderLock)
+{
+    static NeverDestroyed<Vector<String>> names;
+    return names;
+}
+
+static HashSet<String>& seenNames() WTF_REQUIRES_LOCK(folderLock)
+{
+    static NeverDestroyed<HashSet<String>> names;
+    return names;
+}
+
+static void addSeen(const String& name) WTF_REQUIRES_LOCK(folderLock)
+{
+    if (!seenNames().add(name).isNewEntry)
+        return;
+    seenOrder().append(name);
+    if (seenOrder().size() > maxSeen) {
+        seenOrder().removeAt(0, seenOrder().size() - maxSeen / 2);
+        seenNames().clear();
+        for (auto& kept : seenOrder())
+            seenNames().add(kept);
+    }
+}
+
+// Whether the script named was seen before; it is noted if not.
+static bool sawBefore(const String& name) WTF_REQUIRES_LOCK(folderLock)
+{
+    if (!seenLoaded) {
+        seenLoaded = true;
+        auto utf8 = inFolder(folder(), "seen"_s).utf8();
+        if (FILE* file = fopen(reinterpret_cast<const char*>(utf8.data()), "rb")) {
+            char line[32];
+            while (fgets(line, sizeof line, file)) {
+                line[strcspn(line, "\r\n")] = 0;
+                if (*line)
+                    addSeen(String::fromLatin1(line));
+            }
+            fclose(file);
+        }
+    }
+    if (seenNames().contains(name))
+        return true;
+    addSeen(name);
+    seenChanged = true;
+    return false;
+}
+
+static void writeSeen() WTF_REQUIRES_LOCK(folderLock)
+{
+    if (!seenChanged || folder().isEmpty())
+        return;
+    seenChanged = false;
+    auto utf8 = inFolder(folder(), "seen"_s).utf8();
+    FILE* file = fopen(reinterpret_cast<const char*>(utf8.data()), "wb");
+    if (!file)
+        return;
+    for (auto& name : seenOrder()) {
+        auto latin1 = name.latin1();
+        fputs(reinterpret_cast<const char*>(latin1.data()), file);
+        fputc('\n', file);
+    }
+    fclose(file);
+}
+
+// What waits to be written, oldest first. The browser writes it one file at
+// a time when its page is idle (writeAmigaScriptBytecode()), never all at
+// once while a page loads or paints.
+struct PendingWrite {
+    String path;
+    RefPtr<JSC::CachedBytecode> bytecode;
+};
+
+static Lock pendingLock;
+
+static Deque<PendingWrite>& pending() WTF_REQUIRES_LOCK(pendingLock)
+{
+    static NeverDestroyed<Deque<PendingWrite>> writes;
+    return writes;
+}
+
+// The whole file is made in memory and written at once: putting each
+// function's code in place in the file takes a seek and a short write, and
+// AmigaDOS makes those slow (bbc.co.uk's 8 MB took 10 s that way).
+static void writeFile(const String& pathString, const JSC::CachedBytecode& bytecode)
+{
+    size_t had = bytecode.size();
+    Vector<uint8_t> image;
+    image.append(bytecode.span());
+    bytecode.commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        size_t end = static_cast<size_t>(offset) + data.size();
+        if (end > image.size())
+            image.grow(end);
+        memcpy(image.mutableSpan().data() + offset, data.data(), data.size());
+    });
+    auto utf8Path = pathString.utf8();
+    const char* path = reinterpret_cast<const char*>(utf8Path.data());
+    // The file must still be the one read: another task may have written it.
+    struct stat status;
+    if (had && (stat(path, &status) || static_cast<size_t>(status.st_size) != had))
+        return;
+    FILE* file = fopen(path, "wb");
+    if (!file)
+        return;
+    bool ok = fwrite(image.span().data(), 1, image.size(), file) == image.size();
+    if (fclose(file) || !ok)
+        remove(path); // half a file is no file
+}
+
+bool writeAmigaScriptBytecode()
+{
+    PendingWrite write;
+    {
+        Locker locker { pendingLock };
+        if (pending().isEmpty()) {
+            Locker folderLocker { folderLock };
+            writeSeen();
+            return false;
+        }
+        write = pending().takeFirst();
+    }
+    writeFile(write.path, *write.bytecode);
+    return true;
+}
+
+void setAmigaScriptBytecodeFolder(const String& path)
+{
+    Locker locker { folderLock };
+    folder() = path.isolatedCopy();
+    if (!path.isEmpty()) {
+        auto utf8 = path.utf8();
+        mkdir(reinterpret_cast<const char*>(utf8.data()), 0777);
+    }
+}
+
+// FNV-1a over the text's code units, with its length beside it in the name:
+// two texts share a file only if both match (and JavaScriptCore checks the
+// text's own hash and length again when it decodes).
+static uint32_t textHash(StringView text)
+{
+    uint32_t h = 2166136261u;
+    for (unsigned i = 0; i < text.length(); i++) {
+        char16_t c = text[i];
+        h = (h ^ (c & 0xff)) * 16777619u;
+        h = (h ^ (c >> 8)) * 16777619u;
+    }
+    return h;
+}
+
+AmigaScriptBytecode::~AmigaScriptBytecode()
+{
+    commit();
+}
+
+RefPtr<JSC::CachedBytecode> AmigaScriptBytecode::cachedBytecode(StringView source) const
+{
+    Locker locker { m_lock };
+    if (m_loaded)
+        return m_bytecode;
+    m_loaded = true;
+    String dir;
+    {
+        Locker folderLocker { folderLock };
+        dir = folder().isolatedCopy();
+    }
+    if (dir.isEmpty() || source.length() < 1024)
+        return nullptr;     // nothing kept, or a script too short to be worth a file
+    auto separator = dir.endsWith('/') || dir.endsWith(':') ? ""_s : "/"_s;
+    char name[24];
+    snprintf(name, sizeof name, "%08lx-%08lx.jsc", static_cast<unsigned long>(textHash(source)), static_cast<unsigned long>(source.length()));
+    m_path = makeString(dir, separator, String::fromLatin1(name));
+    auto utf8Path = m_path.utf8();
+    FILE* file = fopen(reinterpret_cast<const char*>(utf8Path.data()), "rb");
+    if (!file) {
+        Locker folderLocker { folderLock };
+        m_store = sawBefore(String::fromLatin1(name));
+        return nullptr;
+    }
+    m_store = true; // made afresh only if from another engine version
+    long size = -1;
+    if (!fseek(file, 0, SEEK_END))
+        size = ftell(file);
+    if (size > 0 && !fseek(file, 0, SEEK_SET)) {
+        auto data = MallocSpan<uint8_t, JSC::VMMalloc>::tryMalloc(size);
+        if (data && fread(data.mutableSpan().data(), 1, size, file) == static_cast<size_t>(size))
+            m_bytecode = JSC::CachedBytecode::create(WTF::move(data), { });
+    }
+    fclose(file);
+    return m_bytecode;
+}
+
+// Only called when the script was made afresh: no file (then kept only if
+// its text was seen before), or one from another engine version (written
+// anew).
+void AmigaScriptBytecode::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    Locker locker { m_lock };
+    if (m_path.isEmpty() || !m_store)
+        return;
+    m_bytecode = JSC::CachedBytecode::create();
+    if (auto update = generator())
+        m_bytecode->addGlobalUpdate(*update);
+}
+
+void AmigaScriptBytecode::updateCache(const JSC::UnlinkedFunctionExecutable* executable, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    Locker locker { m_lock };
+    if (!m_bytecode)
+        return;
+    JSC::BytecodeCacheError error;
+    RefPtr<JSC::CachedBytecode> function = JSC::encodeFunctionCodeBlock(executable->vm(), codeBlock, error);
+    if (function && !error.isValid())
+        m_bytecode->addFunctionUpdate(executable, kind, *function);
+}
+
+// What is to be written goes to the writer's list (writeAmigaScriptBytecode()).
+void AmigaScriptBytecode::commit() const
+{
+    PendingWrite write;
+    {
+        Locker locker { m_lock };
+        if (!m_bytecode || !m_bytecode->hasUpdates())
+            return;
+        write.bytecode = std::exchange(m_bytecode, nullptr); // what is written is not added to again
+        write.path = m_path.isolatedCopy();
+    }
+    Locker locker { pendingLock };
+    pending().append(WTF::move(write));
+}
+
+} // namespace WebCore
