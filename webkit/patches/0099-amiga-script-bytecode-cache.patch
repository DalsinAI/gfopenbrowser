+#pragma once
+
+#include <JavaScriptCore/SourceProvider.h>
+#include <wtf/Lock.h>
+#include <wtf/text/WTFString.h>
+
+namespace JSC {
+class CachedBytecode;
+}
+
+namespace WebCore {
+
+// Page and worker scripts translated once: what JavaScriptCore makes from a
+// script (its bytecode, and each function's when it is first called) kept in
+// a file in the browser's folder, named by a hash and the length of the
+// text, and loaded the next time the same text runs. The browser names the
+// folder (setAmigaScriptBytecodeFolder; none: nothing kept) and keeps it to
+// its size. One of these goes with each SourceProvider WebCore makes.
+WEBCORE_EXPORT void setAmigaScriptBytecodeFolder(const String&);
+
+class AmigaScriptBytecode {
+public:
+    AmigaScriptBytecode() = default;
+    ~AmigaScriptBytecode();
+
+    RefPtr<JSC::CachedBytecode> cachedBytecode(StringView source) const;
+    void cacheBytecode(const JSC::BytecodeCacheGenerator&) const;
+    void updateCache(const JSC::UnlinkedFunctionExecutable*, JSC::CodeSpecializationKind, const JSC::UnlinkedFunctionCodeBlock*) const;
+    void commit() const;
+
+private:
+    mutable Lock m_lock;
+    mutable RefPtr<JSC::CachedBytecode> m_bytecode;
+    mutable String m_path;
+    mutable bool m_loaded { false };
+};
+
+} // namespace WebCore
