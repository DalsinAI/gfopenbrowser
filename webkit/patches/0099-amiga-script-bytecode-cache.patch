index 8fc7000..0ae8d2a 100644
--- a/Source/JavaScriptCore/PlatformAmiga.cmake
+++ b/Source/JavaScriptCore/PlatformAmiga.cmake
@@ -74,3 +74,10 @@ function(_amiga_cold_sources)
     set_property(TARGET JavaScriptCore PROPERTY SOURCES ${hotSources} ${coldSources})
 endfunction()
 cmake_language(DEFER CALL _amiga_cold_sources)
+
+# The browser writes the code cache's bytecode to its scripts' files when a
+# page has loaded (WebCore's AmigaScriptBytecode); CodeCache.h itself needs
+# the parser's headers, which are not installed.
+list(APPEND JavaScriptCore_PRIVATE_FRAMEWORK_HEADERS
+    runtime/AmigaCodeCacheWrite.h
+)
