diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPUGlyphsAmiga.c b/Source/WebCore/platform/graphics/amiga/OpenGPUGlyphsAmiga.c
new file mode 100644
index 0000000..d4e9aaf
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPUGlyphsAmiga.c
@@ -0,0 +1,115 @@
+/*
+ * Glyph runs for GraphicsContextOpenGPU (OpenGPUPaintAmiga.h's
+ * ob_openfont_glyphs_available and ob_openfont_draw_glyphs, patch 0082):
+ * gfopenfont.library 1.5's OF_DrawGlyphsA draws them from its own glyph
+ * cache through OpenGPU, straight onto the window or a layer's group. Its
+ * own base, opened once at run time; an older library (or headers from
+ * before revision 5) leaves glyphs to cairo.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "OpenGPUPaintAmiga.h"
+
+#include <exec/types.h>
+#include <exec/libraries.h>
+#include <utility/tagitem.h>
+#include <proto/exec.h>
+#include <libraries/openfont.h>
+#include <opengpu/stream.h>
+
+#include <pthread.h>
+#include <stdlib.h>
+
+#ifdef OPENFONT_REVISION_GPU
+
+/* the engine's other gfopenfont.library calls use OpenFontBase (OpenFontLibrary.c) */
+#define OPENFONT_BASE_NAME OBGlyphsOpenFontBase
+#include <inline/openfont.h>
+
+static struct Library *OBGlyphsOpenFontBase;
+static pthread_once_t s_openOnce = PTHREAD_ONCE_INIT;
+
+static void closeGlyphs(void)
+{
+    if (OBGlyphsOpenFontBase) {
+        CloseLibrary(OBGlyphsOpenFontBase);
+        OBGlyphsOpenFontBase = NULL;
+    }
+}
+
+static void openGlyphs(void)
+{
+    /* the same library the engine's fonts come from (LIBS:, or the program's
+     * drawer): version 1 exactly, revision 5 or later */
+    static const char *const names[] = { OPENFONTNAME, "PROGDIR:Libs/" OPENFONTNAME };
+    unsigned i;
+    for (i = 0; i < sizeof names / sizeof names[0] && !OBGlyphsOpenFontBase; ++i) {
+        OBGlyphsOpenFontBase = OpenLibrary((CONST_STRPTR)names[i], OPENFONT_VERSION);
+        if (OBGlyphsOpenFontBase && (OBGlyphsOpenFontBase->lib_Version != OPENFONT_VERSION
+            || OBGlyphsOpenFontBase->lib_Revision < OPENFONT_REVISION_GPU))
+            closeGlyphs();
+    }
+    if (OBGlyphsOpenFontBase)
+        atexit(closeGlyphs);
+}
+
+int ob_openfont_glyphs_available(void)
+{
+    pthread_once(&s_openOnce, openGlyphs);
+    return OBGlyphsOpenFontBase != NULL;
+}
+
+long ob_openfont_draw_glyphs(void *face, const struct obgpu_glyphs *where, const unsigned long *glyphs, const long *positions,
+    unsigned long count, unsigned long pixel_size, unsigned long argb, const long *matrix, int aliased)
+{
+    struct OFGPUTarget t;
+    struct OFGlyphRun r;
+    LONG m[4];
+    int i;
+    if (!ob_openfont_glyphs_available())
+        return OFERR_NOGPU;
+    t.gt_Address = (APTR)where->target;
+    t.gt_BytesPerRow = where->bpr;
+    t.gt_Width = (UWORD)where->w;
+    t.gt_Height = (UWORD)where->h;
+    t.gt_Format = OGPU_FMT_ARGB32;
+    t.gt_ClipX = (WORD)where->cx0;
+    t.gt_ClipY = (WORD)where->cy0;
+    t.gt_ClipW = (WORD)(where->cx1 - where->cx0);
+    t.gt_ClipH = (WORD)(where->cy1 - where->cy0);
+    t.gt_MaskAddress = (APTR)where->mask;
+    t.gt_MaskBytesPerRow = where->mask_bpr;
+    t.gt_MaskX = (WORD)where->mask_x;
+    t.gt_MaskY = (WORD)where->mask_y;
+    t.gt_MaskW = (WORD)where->mask_w;
+    t.gt_MaskH = (WORD)where->mask_h;
+    if (matrix)
+        for (i = 0; i < 4; i++)
+            m[i] = (LONG)matrix[i];
+    r.gr_Glyphs = (ULONG *)glyphs;
+    r.gr_Positions = (LONG *)positions;
+    r.gr_Count = count;
+    r.gr_PixelSize = pixel_size;
+    r.gr_Color = argb;
+    r.gr_Operator = OGPU_PD_OVER;
+    r.gr_Matrix = matrix ? m : NULL;
+    r.gr_Flags = aliased ? OFGR_ALIASED : 0;
+    return OF_DrawGlyphsA((struct OFFace *)face, &t, &r, NULL);
+}
+
+#else
+
+/* gfopenfont.library's headers from before revision 5: glyphs stay cairo's */
+int ob_openfont_glyphs_available(void)
+{
+    return 0;
+}
+
+long ob_openfont_draw_glyphs(void *face, const struct obgpu_glyphs *where, const unsigned long *glyphs, const long *positions,
+    unsigned long count, unsigned long pixel_size, unsigned long argb, const long *matrix, int aliased)
+{
+    (void)face; (void)where; (void)glyphs; (void)positions; (void)count; (void)pixel_size; (void)argb; (void)matrix; (void)aliased;
+    return -1;
+}
+
+#endif
diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c
index 7af5a94..c34fe09 100644
--- a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c
@@ -1519,3 +1519,42 @@ other:
     l->flags |= OBGPU_L_CLIP_OTHER;
     return 0;
 }
+
+/* ---- glyph runs, drawn by gfopenfont.library (0082) ---------------------------------------- */
+
+int obgpu_glyphs_here(const struct obgpu *g, struct obgpu_glyphs *out)
+{
+    const struct obgpu_level *l = current(g);
+    const struct obgpu_mask *k = clipMask(g);
+    int i;
+    if (!obgpu_drawable(g) || l->cx1 <= l->cx0 || l->cy1 <= l->cy0)
+        return 0;
+    out->target = g->target;
+    out->bpr = g->target_bpr;
+    out->w = g->target_w;
+    out->h = g->target_h;
+    out->cx0 = l->cx0;
+    out->cy0 = l->cy0;
+    out->cx1 = l->cx1;
+    out->cy1 = l->cy1;
+    out->mask = k ? k->address : 0;
+    out->mask_bpr = k ? k->bpr : 0;
+    out->mask_x = k ? k->x : 0;
+    out->mask_y = k ? k->y : 0;
+    out->mask_w = k ? k->w : 0;
+    out->mask_h = k ? k->h : 0;
+    for (i = 0; i < 4; i++)
+        out->m[i] = l->m[i];
+    return 1;
+}
+
+int obgpu_map(const struct obgpu *g, long x, long y, long *tx, long *ty)
+{
+    const struct obgpu_level *l = current(g);
+    obgpu_s64 X = mapX(l->m, x, y), Y = mapY(l->m, x, y);
+    if (X <= -0x7FFFFF00LL || X >= 0x7FFFFF00LL || Y <= -0x7FFFFF00LL || Y >= 0x7FFFFF00LL)
+        return 0;
+    *tx = (long)X;
+    *ty = (long)Y;
+    return 1;
+}
diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h
index c7940a4..61271a7 100644
--- a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h
@@ -307,6 +307,25 @@ int obgpu_stroke_path_pattern(struct obgpu *g, const struct obgpu_pattern *patte
 #define OBGPU_CLIP_OUT      4
 int obgpu_clip_path(struct obgpu *g, int flags);
 
+/* Glyph runs (0082) are drawn by gfopenfont.library's OF_DrawGlyphsA, from
+ * its own glyph cache, straight onto the target: where it draws now (the
+ * target, or a group's surface; the clip rectangle and the clip's A8 mask,
+ * in the target's pixels) and the transform's linear part. 0 when nothing
+ * may be drawn here. Send the batch first: the library draws at once. */
+struct obgpu_glyphs {
+    unsigned long target;
+    long bpr;
+    int w, h;
+    int cx0, cy0, cx1, cy1;
+    unsigned long mask;         /* 0: none */
+    long mask_bpr;
+    int mask_x, mask_y, mask_w, mask_h;
+    long m[4];                  /* a, b, c, d, 16.16 */
+};
+int obgpu_glyphs_here(const struct obgpu *g, struct obgpu_glyphs *out);
+/* A point (24.8, the user's space) on the target (24.8); 0 past the fixed point. */
+int obgpu_map(const struct obgpu *g, long x, long y, long *tx, long *ty);
+
 /* Words waiting to be drawn. */
 int obgpu_pending(const struct obgpu *g);
 /* Sends the batch and waits for it, if it draws anything; 0, or the error. */
@@ -317,6 +336,15 @@ long obgpu_flush(struct obgpu *g);
  * missing or older than stream v1.4; and sends a batch and waits for it. */
 int ob_opengpu_caps(void);
 long ob_opengpu_run(const unsigned char *stream, long words);
+/* openamigabrowser's engine only (OpenGPUGlyphsAmiga.c, 0082):
+ * gfopenfont.library 1.5's OF_DrawGlyphsA is there; and a run drawn with it
+ * (face an OFFace; positions x, y pairs, 24.8 target pixels; colour
+ * premultiplied ARGB32; matrix 16.16 a, b, c, d about each pen or 0;
+ * aliased: no anti-aliasing): the glyphs drawn, or a negative openfont
+ * error (OFERR_ARGUMENT for aliased where OpenGPU doesn't take it). */
+int ob_openfont_glyphs_available(void);
+long ob_openfont_draw_glyphs(void *face, const struct obgpu_glyphs *where, const unsigned long *glyphs, const long *positions,
+    unsigned long count, unsigned long pixel_size, unsigned long argb, const long *matrix, int aliased);
 
 #ifdef __cplusplus
 }
