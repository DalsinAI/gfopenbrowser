@@ -26,6 +26,11 @@
 #include "NativeImage.h"
 #include "Path.h"
 #include "Pattern.h"
+#include "Font.h"
+#include "FontPlatformData.h"
+#if USE(OPENFONT)
+#include "OpenFontFace.h"
+#endif
 #if USE(THEME_ADWAITA)
 #include "Adwaita.h"
