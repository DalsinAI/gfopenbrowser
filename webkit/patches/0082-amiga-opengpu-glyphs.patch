+// Glyph runs (0082) as GraphicsContextCairo draws them (Cairo::drawGlyphs
+// with the face's cairo user font): each glyph at the point plus the
+// advances before it, filled with the fill colour times the global alpha,
+// drawn twice for synthetic bold (moved by its offset along x). Here
+// gfopenfont.library 1.5's OF_DrawGlyphsA draws them from its own glyph
+// cache: an OpenFont face, fill only, a colour (no gradient or pattern),
+// source-over, normal blending, no shadow, no colour glyphs and no
+// synthetic oblique; anti-aliased, or not with FontSmoothingMode::None
+// where OpenGPU takes aliased paths. The device size is the font's size
+// through the transform: a whole number of pixels under a scale (the
+// cache), any other size or a turn as a matrix about each pen.
+bool GraphicsContextOpenGPU::glyphsHere(const Font& font, std::span<const GlyphBufferGlyph> glyphs, std::span<const GlyphBufferAdvance> advances, const FloatPoint& point, FontSmoothingMode smoothing)
+{
+#if USE(OPENFONT)
+    auto& data = font.platformData();
+    OpenFontFace* face = data.openFontFace();
+    if (!m_gpu || !face || !face->face() || face->hasColor() || data.syntheticOblique() || !data.size() || glyphs.size() > 4096
+        || textDrawingMode() != TextDrawingModeFlags(TextDrawingMode::Fill) || hasDropShadow() || blendMode() != BlendMode::Normal
+        || compositeOperation() != CompositeOperator::SourceOver || fillBrush().gradient() || fillBrush().pattern()
+        || !ob_openfont_glyphs_available())
+        return false;
+    obgpu_glyphs where;
+    if (!obgpu_glyphs_here(m_gpu, &where))
+        return false;
+    // the size on the target: a scale (and a whole pixel size) uses the cache
+    double a = where.m[0] / 65536.0, b = where.m[1] / 65536.0, c = where.m[2] / 65536.0, d = where.m[3] / 65536.0;
+    double size = data.size();
+    unsigned long pixelSize = 0;
+    long matrix[4];
+    bool useMatrix = true;
+    if (!b && !c && a == d && a > 0) {
+        double device = size * a;
+        if (std::abs(device - std::round(device)) < 1.0 / 1024 && device >= 1 && device < 4096) {
+            pixelSize = static_cast<unsigned long>(std::lround(device));
+            useMatrix = false;
+        }
+    }
+    if (useMatrix) {
+        pixelSize = static_cast<unsigned long>(std::ceil(size));
+        if (pixelSize < 1 || pixelSize > 4096)
+            return false;
+        double k = size / pixelSize, linear[4] = { a * k, c * k, b * k, d * k };
+        for (int i = 0; i < 4; i++) {
+            if (!(std::abs(linear[i]) < 32767))
+                return false;
+            matrix[i] = std::lround(linear[i] * 65536);
+        }
+    }
+    bool aliased = smoothing == FontSmoothingMode::None;
+    if (aliased && !(m_gpu->caps & OBGPU_CAN_ALIASED))
+        return false;
+    // the pens on the target, 24.8
+    Vector<unsigned long, 128> ids(glyphs.size(), [&](size_t i) { return static_cast<unsigned long>(glyphs[i]); });
+    Vector<long, 256> pens(glyphs.size() * 2);
+    float boldOffset = font.syntheticBoldOffset();
+    for (int pass = 0; pass < (boldOffset ? 2 : 1); pass++) {
+        double x = point.x() + (pass ? boldOffset : 0), y = point.y();
+        for (size_t i = 0; i < glyphs.size(); i++) {
+            if (!(std::abs(x) < (1 << 22)) || !(std::abs(y) < (1 << 22))
+                || !obgpu_map(m_gpu, std::lround(x * 256), std::lround(y * 256), &pens[i * 2], &pens[i * 2 + 1]))
+                return false;
+            x += advances[i].width();
+            y += advances[i].height();
+        }
+        // OpenGPU draws at once: the batch before it, and cairo's own drawing, go first
+        flush();
+        cairo_surface_t* surface = m_drawSurface ? m_drawSurface : m_surface;
+        cairo_surface_flush(surface);
+        Color color = alpha() < 1 ? fillColor().colorWithAlphaMultipliedBy(alpha()) : fillColor();
+        long drawn;
+        {
+            Locker locker { OpenFontFace::lock() };
+            drawn = ob_openfont_draw_glyphs(face->face(), &where, ids.span().data(), pens.span().data(), glyphs.size(), pixelSize,
+                premultiplied(color), useMatrix ? matrix : nullptr, aliased);
+        }
+        cairo_surface_mark_dirty(surface);
+        // the first pass failing leaves nothing drawn: cairo draws it all
+        if (drawn < 0) {
+            if (pass)
+                fprintf(stderr, "OpenBrowser: gfopenfont.library could not draw a run's synthetic bold (%ld)\n", drawn);
+            return !!pass;
+        }
+        m_counts->draws += glyphs.size();
+    }
+    return true;
+#else
+    UNUSED_PARAM(font);
+    UNUSED_PARAM(glyphs);
+    UNUSED_PARAM(advances);
+    UNUSED_PARAM(point);
+    UNUSED_PARAM(smoothing);
+    return false;
+#endif
+}
+
 void GraphicsContextOpenGPU::drawGlyphs(const Font& font, std::span<const GlyphBufferGlyph> glyphs, std::span<const GlyphBufferAdvance> advances, const FloatPoint& point, FontSmoothingMode smoothing)
 {
+    if (glyphsHere(font, glyphs, advances, point, smoothing))
+        return;
     handOn(OBGPU_GLYPHS);
     m_cairo.drawGlyphs(font, glyphs, advances, point, smoothing);
 }
