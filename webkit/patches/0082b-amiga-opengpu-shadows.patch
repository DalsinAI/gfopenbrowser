@@ -1184,6 +1190,161 @@ static int patternWords(struct obgpu *g, const struct obgpu_pattern *p, unsigned
     return 1;
 }
 
+static int pathBox(struct obgpu *g, int *b);
+
+void obgpu_set_shadow(struct obgpu *g, const struct obgpu_shadow *s)
+{
+    g->has_shadow = s != 0;
+    if (!s)
+        return;
+    g->shadow_dx = s->dx;
+    g->shadow_dy = s->dy;
+    g->shadow_box_x = s->box_x;
+    g->shadow_box_y = s->box_y;
+    g->shadow_argb = s->argb & 0xFFFFFFFFUL;
+    g->shadow_mask_alpha = s->mask_alpha > 255 ? 255 : s->mask_alpha;
+}
+
+/* the core's box size for a radius (stream.h: sigma = radius / 2, d = sigma
+ * 3 sqrt(2 pi) / 4 + 1/2, rounded down), as ogpu_core.c works it out */
+static int boxOf(unsigned long r)
+{
+    return (int)((((obgpu_s64)r << 11) * 123207 + 0x80000000LL) >> 32);
+}
+
+unsigned long obgpu_blur_radius_for_box(int box)
+{
+    obgpu_s64 r;
+    if (box < 2)
+        return 0;
+    r = (((obgpu_s64)box << 32) - 0x80000000LL) / ((obgpu_s64)123207 << 11);
+    if (r < 0)
+        r = 0;
+    while (r < 0xFFFF && boxOf((unsigned long)r) < box)
+        r++;
+    while (r > 0 && boxOf((unsigned long)r - 1) >= box)
+        r--;
+    return r > 0xFFFF ? 0xFFFF : (unsigned long)r;
+}
+
+/* The shadow of the open path (its words at a[5], a[6], drawn by a[] as the
+ * shape will be): into an A8 layer over its box moved by the offset and
+ * grown by the blur, blurred, times the clip's mask, then the shadow's
+ * colour through it. 0 when it can't be cast (nothing added then). */
+static int castShadow(struct obgpu *g, const int *box, const unsigned long *a, int n, unsigned long flags, const struct obgpu_stroke *s)
+{
+    const struct obgpu_level *l = current(g);
+    const struct obgpu_mask *k = clipMask(g);
+    unsigned long b2[21], radii;
+    unsigned char *block;
+    unsigned long address = 0;
+    long grow = 2, w, h, bx, by, x1, y1, pad;
+    int i, slot, kslot = 0, d = g->shadow_box_x > g->shadow_box_y ? g->shadow_box_x : g->shadow_box_y;
+    obgpu_s64 m[6];
+    if (!box)
+        return 1;
+    if (s) {
+        /* the stroke's reach past the path, through the transform */
+        obgpu_s64 scale = 0;
+        for (i = 0; i < 4; i++)
+            if ((l->m[i] < 0 ? -(obgpu_s64)l->m[i] : l->m[i]) > scale)
+                scale = l->m[i] < 0 ? -(obgpu_s64)l->m[i] : l->m[i];
+        grow += (long)(((obgpu_s64)s->width * scale >> 16) * (s->join == OBGPU_JOIN_MITER && s->miter > 0x10000 ? s->miter >> 16 : 1) / 65536) + 2;
+    }
+    pad = d < 2 ? 1 : 3 * d / 2 + 2;
+    bx = box[0] - grow + floorShift(g->shadow_dx, 8) - pad;
+    by = box[1] - grow + floorShift(g->shadow_dy, 8) - pad;
+    x1 = box[2] + grow + floorShift(g->shadow_dx + 255, 8) + pad;
+    y1 = box[3] + grow + floorShift(g->shadow_dy + 255, 8) + pad;
+    /* only what can reach the clip */
+    if (bx < l->cx0 - pad) bx = l->cx0 - pad;
+    if (by < l->cy0 - pad) by = l->cy0 - pad;
+    if (x1 > l->cx1 + pad) x1 = l->cx1 + pad;
+    if (y1 > l->cy1 + pad) y1 = l->cy1 + pad;
+    w = x1 - bx;
+    h = y1 - by;
+    if (w <= 0 || h <= 0)
+        return 1;
+    if (w > OBGPU_MAX_SIDE || h > OBGPU_MAX_SIDE || (unsigned long)(w + 4) * 32 > g->work_bytes
+        || (unsigned long)(w > h ? w : h) * 8 > g->work_bytes)
+        return 0;
+    block = g->mask_alloc(g->mask_user, (unsigned long)((w + 3) & ~3L) * (unsigned long)h, &address);
+    if (!block)
+        return 0;
+    g->temp[g->temps++] = block;
+    {
+        struct obgpu_source src;
+        src.address = address;
+        src.bpr = (w + 3) & ~3L;
+        src.w = (int)w;
+        src.h = (int)h;
+        src.format = OBGPU_A8;
+        slot = slotOf(g, &src);
+    }
+    if (k)
+        kslot = maskSlot(g, k);
+    /* the layer, cleared */
+    b2[0] = (unsigned long)slot;
+    emit(g, OGPU_OP_TARGET, 1, b2);
+    b2[0] = xy(0, 0);
+    b2[1] = xy(w, h);
+    emit(g, OGPU_OP_CLIP, 2, b2);
+    b2[2] = 0;
+    emit(g, OGPU_OP_FILL, 3, b2);
+    /* the shape, moved, its coverage times the mask alpha */
+    for (i = 0; i < n; i++)
+        b2[i] = a[i];
+    for (i = 0; i < 6; i++)
+        m[i] = l->m[i];
+    m[4] += g->shadow_dx - bx * 256;
+    m[5] += g->shadow_dy - by * 256;
+    if (!matrixWords(m, b2 + 7))
+        return 0;
+    b2[0] = (unsigned long)OGPU_PD_OVER | (flags & ~(unsigned long)OGPU_PATH_MASK);
+    b2[1] = (unsigned long)g->shadow_mask_alpha << 24;
+    b2[2] = 0;
+    b2[3] = 0;
+    b2[4] = 0;
+    emit(g, s ? OGPU_OP_PATH_STROKE : OGPU_OP_PATH_FILL, n, b2);
+    /* ShadowBlur's three boxes each way */
+    if (g->shadow_box_x >= 2 || g->shadow_box_y >= 2) {
+        radii = obgpu_blur_radius_for_box(g->shadow_box_x) << 16 | obgpu_blur_radius_for_box(g->shadow_box_y);
+        b2[0] = xy(0, 0);
+        b2[1] = xy(w, h);
+        b2[2] = radii;
+        b2[3] = g->work;
+        b2[4] = g->work_bytes;
+        emit(g, OGPU_OP_BLUR, 5, b2);
+    }
+    /* outside the clip's mask nothing is drawn */
+    if (k) {
+        b2[0] = OGPU_PD_IN_REVERSE;
+        b2[1] = (unsigned long)kslot;
+        b2[2] = xy(bx - k->x, by - k->y);
+        b2[3] = 0;
+        b2[4] = 0;
+        b2[5] = xy(0, 0);
+        b2[6] = xy(w, h);
+        emit(g, OGPU_OP_COMPOSITE_PD, 7, b2);
+    }
+    /* the colour through it, on the target */
+    b2[0] = 0;
+    emit(g, OGPU_OP_TARGET, 1, b2);
+    g->clip_sent = 0;
+    sendClip(g);
+    b2[0] = (unsigned long)OGPU_PD_OVER | OGPU_PD_SOLID | OGPU_PD_MASK;
+    b2[1] = g->shadow_argb;
+    b2[2] = 0;
+    b2[3] = (unsigned long)slot;
+    b2[4] = xy(0, 0);
+    b2[5] = xy(bx, by);
+    b2[6] = xy(w, h);
+    emit(g, OGPU_OP_COMPOSITE_PD, 7, b2);
+    g->drawn++;
+    g->counts->draws++;
+    return 1;
+}
+
 /* The open path filled or stroked: PATH_FILL or PATH_STROKE with its words,
  * the paint's and the dashes' after them in scratch. */
 static int pathDraw(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gr,
@@ -1194,7 +1355,7 @@ static int pathDraw(struct obgpu *g, unsigned long argb, const struct obgpu_grad
     int state = g->path_state, pd = pdOperator(op), i, n = 15;
     obgpu_s64 m[6];
     unsigned long a[21], paint = argb & 0xFFFFFFFFUL, dash = 0;
-    int dashes = s ? s->dashes : 0;
+    int dashes = s ? s->dashes : 0, shadowBox[4], shadowAny = 0;
     g->path_state = 0;
     if (state != OBGPU_PATH_OPEN) {
         if (state)
@@ -1205,6 +1366,9 @@ static int pathDraw(struct obgpu *g, unsigned long argb, const struct obgpu_grad
     if (!obgpu_drawable(g) || pd < 0 || (gr && !gradientOk(gr)) || (pat && !patternOk(pat))
         || (g->aliased && !(g->caps & OBGPU_CAN_ALIASED)))
         goto cairo;
+    /* ShadowBlur's shadows: source-over, a colour's (0082b) */
+    if (g->has_shadow && (pd != OGPU_PD_OVER || gr || pat || !g->mask_alloc || g->temps >= 16))
+        goto cairo;
     if (g->aliased)
         flags |= OGPU_PATH_ALIASED;
     if (s && (s->cap < OBGPU_CAP_BUTT || s->cap > OBGPU_CAP_SQUARE || s->join < OBGPU_JOIN_MITER
@@ -1235,11 +1399,14 @@ static int pathDraw(struct obgpu *g, unsigned long argb, const struct obgpu_grad
                 break;
             }
     extra += dashes;
-    if (!pathRoom(g, extra, 1))
+    if (!pathRoom(g, extra, g->has_shadow ? 4 : 1))
         goto cairo;
     start = g->path_start;
     if (s && s->cap != OBGPU_CAP_BUTT)
         pathDots(g, start, len);
+    /* the shadow's box, from the path's words alone (the paint's and the dashes' follow them) */
+    if (g->has_shadow)
+        shadowAny = pathBox(g, shadowBox);
     if (gr && !gradientWords(g, gr, &paint))
