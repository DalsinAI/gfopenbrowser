         : obgpu_stroke_path(m_gpu, paint.argb, paint.hasGradient ? &paint.gradient : nullptr, &stroke, op);
+    obgpu_set_shadow(m_gpu, nullptr);
     if (drawn)
         keepPicture(paint);
     return drawn;
@@ -802,6 +858,29 @@ bool GraphicsContextOpenGPU::patternRect(const FloatRect& rect, const Pattern& p
     return fillPathWith(path, paint, false, compositeOperation());
 }
 
+// The mask alpha of ShadowBlur's path shadow for a brush (drawPathShadow
+// fills the shape with the paint, NoAdjustment: a colour's own alpha,
+// without the global alpha). Gradients and patterns cast none here: 255,
+// and the writer leaves such a shadow to cairo.
+int GraphicsContextOpenGPU::brushShadowAlpha(const SourceBrush& brush)
+{
+    if (brush.gradient() || brush.pattern())
+        return 255;
+    return static_cast<int>(premultiplied(brush.color()) >> 24);
+}
+
+// A rectangle of one colour with the context's shadow: its path.
+bool GraphicsContextOpenGPU::shadowedRect(const FloatRect& rect, const Color& color, int shadowMaskAlpha)
+{
+    if (!pathsWanted(false))
+        return false;
+    Paint paint;
+    paint.argb = premultiplied(color);
+    Path path;
+    path.addRect(rect);
+    return fillPathWith(path, paint, false, compositeOperation(), shadowMaskAlpha);
+}
+
 bool GraphicsContextOpenGPU::solidFill(const FloatRect& rect, const Color& color, CompositeOperator op, BlendMode blendMode)
 {
     long r[4];
@@ -826,7 +905,11 @@ void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, RequiresClipToRect
     if (!brush.gradient() && !brush.pattern()) {
         // as Cairo::fillRect with a FillSource: the colour times the global alpha
         Color color = alpha() < 1 ? fillColor().colorWithAlphaMultipliedBy(alpha()) : fillColor();
-        if (solidFill(rect, color, compositeOperation(), blendMode()))
+        if (hasDropShadow()) {
+            // Cairo::fillRect with a FillSource: drawPathShadow, the colour's own alpha
+            if (shadowedRect(rect, color, static_cast<int>(premultiplied(fillColor()) >> 24)))
+                return;
+        } else if (solidFill(rect, color, compositeOperation(), blendMode()))
             return;
         handOn(OBGPU_FILL);
     } else if (brush.gradient()) {
@@ -848,7 +931,8 @@ void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, const Color& color)
     // invisible colour over
     if (!color.isVisible() && compositeOperation() == CompositeOperator::SourceOver && blendMode() == BlendMode::Normal && !hasDropShadow())
         return;
-    if (solidFill(rect, color, compositeOperation(), blendMode()))
+    // with a shadow: ShadowBlur's rectangle shadow, of the rectangle's coverage
+    if (hasDropShadow() ? shadowedRect(rect, color, 255) : solidFill(rect, color, compositeOperation(), blendMode()))
         return;
     handOn(OBGPU_FILL);
     m_cairo.fillRect(rect, color);
@@ -939,13 +1023,14 @@ void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, Gradient& gradient,
 
 void GraphicsContextOpenGPU::fillRoundedRectImpl(const FloatRoundedRect& rect, const Color& color)
 {
-    // as Cairo::fillRoundedRect: the colour as it is, no global alpha
-    if (pathsWanted()) {
+    // as Cairo::fillRoundedRect: the colour as it is, no global alpha;
+    // its shadow ShadowBlur's rectangle shadow (0082b)
+    if (pathsWanted(false)) {
         Paint paint;
         paint.argb = premultiplied(color);
         Path path;
         path.addRoundedRect(rect);
-        if (fillPathWith(path, paint, false, compositeOperation()))
+        if (fillPathWith(path, paint, false, compositeOperation(), 255))
             return;
     }
     handOn(OBGPU_ROUNDED);
@@ -975,10 +1060,11 @@ void GraphicsContextOpenGPU::fillRectWithRoundedHole(const FloatRect& rect, cons
 void GraphicsContextOpenGPU::strokeRect(const FloatRect& rect, float lineWidth)
 {
     Paint paint;
-    if (pathsWanted() && paintFor(strokeBrush(), paint)) {
+    // the shadow ShadowBlur's path shadow (0082b), the stroke colour's alpha
+    if (pathsWanted(false) && paintFor(strokeBrush(), paint)) {
         Path path;
         path.addRect(rect);
-        if (strokePathWith(path, paint, lineWidth))
+        if (strokePathWith(path, paint, lineWidth, brushShadowAlpha(strokeBrush())))
             return;
     }
     handOn(OBGPU_STROKE);
@@ -990,7 +1076,8 @@ void GraphicsContextOpenGPU::fillPath(const Path& path)
     if (path.isEmpty())
         return;
     Paint paint;
-    if (pathsWanted() && paintFor(fillBrush(), paint) && fillPathWith(path, paint, fillRule() == WindRule::EvenOdd, compositeOperation()))
+    if (pathsWanted(false) && paintFor(fillBrush(), paint)
+        && fillPathWith(path, paint, fillRule() == WindRule::EvenOdd, compositeOperation(), brushShadowAlpha(fillBrush())))
         return;
     handOn(OBGPU_PATH);
     m_cairo.fillPath(path);
@@ -1001,7 +1088,8 @@ void GraphicsContextOpenGPU::strokePath(const Path& path)
     if (path.isEmpty())
         return;
     Paint paint;
-    if (pathsWanted() && paintFor(strokeBrush(), paint) && strokePathWith(path, paint, cairo_get_line_width(m_cairo.cr())))
+    if (pathsWanted(false) && paintFor(strokeBrush(), paint)
+        && strokePathWith(path, paint, cairo_get_line_width(m_cairo.cr()), brushShadowAlpha(strokeBrush())))
         return;
     handOn(OBGPU_STROKE);
     m_cairo.strokePath(path);
