@@ -755,26 +755,82 @@ bool GraphicsContextOpenGPU::beginPath(const Path& path)
     return fits;
 }
 
-bool GraphicsContextOpenGPU::fillPathWith(const Path& path, const Paint& paint, bool evenOdd, CompositeOperator op)
+// The context's drop shadow for the next fill or stroke, as WebKit's
+// ShadowBlur casts it (0082b): shadowMaskAlpha -1 for a call whose cairo
+// form casts none, 255 for ShadowBlur's rectangle shadows (fillRect with a
+// colour, fillRoundedRect), the paint colour's own alpha for its path
+// shadows (fills and strokes through a FillSource or StrokeSource). The
+// box sizes are ShadowBlur's (calculateLobes, Dale's choice): a canvas
+// shadow (shadowsIgnoreTransforms) 2/3 of the blur, a CSS one sigma =
+// blur / 2 times 3 sqrt(2 pi) / 4 times 0.88, rounded, at least 2; blurs
+// over 128 as 128. Drawn here under a transform that only moves (ShadowBlur
+// scales blurs and offsets under others), source-over, normal blending.
+// false when it can't be: the caller hands the call to cairo.
+bool GraphicsContextOpenGPU::shadowHere(int shadowMaskAlpha)
+{
+    obgpu_set_shadow(m_gpu, nullptr);
+    if (shadowMaskAlpha < 0 || !hasDropShadow())
+        return true;
+    auto shadow = dropShadow();
+    // ShadowState::isVisible: none to cast
+    if (!shadow || !shadow->color.isVisible() || (!shadow->offset.width() && !shadow->offset.height() && !shadow->radius))
+        return true;
+    auto ctm = getCTM(PossiblyIncludeDeviceScale);
+    if (ctm.a() != 1 || ctm.b() || ctm.c() || ctm.d() != 1 || compositeOperation() != CompositeOperator::SourceOver
+        || blendMode() != BlendMode::Normal || !(std::abs(shadow->offset.width()) < 32767) || !(std::abs(shadow->offset.height()) < 32767))
+        return false;
+    float radius = std::min(shadow->radius, 128.0f);
+    int box = 0;
+    if (radius > 0) {
+        if (shadowsIgnoreTransforms())
+            box = std::max(2, static_cast<int>(floorf((2 / 3.f) * radius)));
+        else {
+            float stdDev = radius / 2;
+            const float gaussianKernelFactor = 3 / 4.f * sqrtf(2 * std::numbers::pi_v<float>);
+            const float fudgeFactor = 0.88f;
+            box = std::max(2, static_cast<int>(floorf(stdDev * gaussianKernelFactor * fudgeFactor + 0.5f)));
+        }
+    }
+    obgpu_shadow s;
+    s.dx = std::lround(shadow->offset.width() * 256);
+    s.dy = std::lround(shadow->offset.height() * 256);
+    s.box_x = s.box_y = box;
+    s.argb = premultiplied(alpha() < 1 ? shadow->color.colorWithAlphaMultipliedBy(alpha()) : shadow->color);
+    s.mask_alpha = static_cast<unsigned>(shadowMaskAlpha);
+    obgpu_set_shadow(m_gpu, &s);
+    return true;
+}
+
+bool GraphicsContextOpenGPU::fillPathWith(const Path& path, const Paint& paint, bool evenOdd, CompositeOperator op, int shadowMaskAlpha)
 {
-    if (!beginPath(path))
+    if (!shadowHere(shadowMaskAlpha))
+        return false;
+    if (!beginPath(path)) {
+        obgpu_set_shadow(m_gpu, nullptr);
         return false;
+    }
     bool drawn = paint.hasPattern ? obgpu_fill_path_pattern(m_gpu, &paint.pattern, evenOdd, static_cast<int>(op))
         : obgpu_fill_path(m_gpu, paint.argb, paint.hasGradient ? &paint.gradient : nullptr, evenOdd, static_cast<int>(op));
+    obgpu_set_shadow(m_gpu, nullptr);
     if (drawn)
         keepPicture(paint);
     return drawn;
 }
 
-bool GraphicsContextOpenGPU::strokePathWith(const Path& path, const Paint& paint, double width)
+bool GraphicsContextOpenGPU::strokePathWith(const Path& path, const Paint& paint, double width, int shadowMaskAlpha)
 {
     obgpu_stroke stroke;
     long dashes[64];
-    if (!strokeFor(width, stroke, dashes) || !beginPath(path))
+    if (!strokeFor(width, stroke, dashes) || !shadowHere(shadowMaskAlpha))
+        return false;
+    if (!beginPath(path)) {
