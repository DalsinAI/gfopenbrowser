diff --git a/Source/WebCore/style/StyleScope.cpp b/Source/WebCore/style/StyleScope.cpp
--- a/Source/WebCore/style/StyleScope.cpp
+++ b/Source/WebCore/style/StyleScope.cpp
@@ -64,6 +64,7 @@
 #include "StyleCustomPropertyRegistry.h"
 #include "StyleInvalidator.h"
 #include "StyleResolver.h"
+#include "StyleRule.h"
 #include "StyleSheetContents.h"
 #include "StyleSheetList.h"
 #include "UserContentController.h"
@@ -585,6 +586,21 @@
     auto styleSheetChange = StyleSheetChange { ResolverUpdateType::Reconstruct };
     if (updateType == UpdateType::ActiveSet)
         styleSheetChange = analyzeStyleSheetChange(activeCSSStyleSheets);
+#if PLATFORM(AMIGA)
+    // Rules inserted into sheets in use: every rule set is built again from
+    // the sheets (so the cascade's order stays exact), and the invalidation
+    // is the inserted rules' alone, as for a sheet added.
+    if (auto insertedRules = std::exchange(m_insertedRules, { }); !insertedRules.isEmpty()
+        && styleSheetChange.resolverUpdateType != ResolverUpdateType::Reconstruct) {
+        Ref insertedContents = StyleSheetContents::create(m_document->cssParserContext());
+        for (auto& rule : insertedRules)
+            insertedContents->parserAppendRule(rule.copyRef());
+        styleSheetChange.resolverUpdateType = ResolverUpdateType::Reset;
+        styleSheetChange.addedSheets.append(WTF::move(insertedContents));
+        if (auto* documentScope = dynamicDowncast<DocumentScope>(*this))
+            documentScope->m_matchResultCache = { };
+    }
+#endif
 
     updateResolver(activeCSSStyleSheets, styleSheetChange.resolverUpdateType);
 
@@ -723,6 +739,10 @@
 
 void Scope::scheduleUpdate(UpdateType update)
 {
+#if PLATFORM(AMIGA)
+    if (update != UpdateType::ActiveSet)
+        m_insertedRules.clear(); // every rule set is built again and everything restyled
+#endif
     if (update == UpdateType::ContentsOrInterpretation) {
         // :host and ::slotted rules might go away.
         if (m_shadowRoot) {
@@ -757,6 +777,21 @@
     scheduleUpdate(UpdateType::ContentsOrInterpretation);
 }
 
+#if PLATFORM(AMIGA)
+bool Scope::didInsertRuleIntoActiveStyleSheet(const CSSStyleSheet&, StyleRuleBase& rule)
+{
+    // A shadow tree's resolver can be shared, and without a resolver (or with
+    // a bigger update due) every rule set is built again anyway.
+    if (m_shadowRoot || !m_resolver || m_resolver->isSharedBetweenShadowTrees())
+        return false;
+    if (m_pendingUpdate && *m_pendingUpdate != UpdateType::ActiveSet)
+        return false;
+    m_insertedRules.append(rule);
+    scheduleUpdate(UpdateType::ActiveSet);
+    return true;
+}
+#endif
+
 void Scope::didChangeViewportSize()
 {
     Ref<ContainerNode> rootNode = m_document;
