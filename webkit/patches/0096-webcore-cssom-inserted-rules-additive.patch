+#if PLATFORM(AMIGA)
+    // CSSOM inserted a rule into an active sheet. True when the scope takes
+    // it as an addition: the rule sets are rebuilt and only the elements the
+    // rule can match restyled. False: call didChangeStyleSheetContents().
+    bool didInsertRuleIntoActiveStyleSheet(const CSSStyleSheet&, StyleRuleBase&);
+#endif
 
     void didChangeViewportSize();
 
@@ -231,6 +238,11 @@
     WeakListHashSet<Node, WeakPtrImplWithEventTargetData> m_styleSheetCandidateNodes;
 
     std::optional<UpdateType> m_pendingUpdate;
+#if PLATFORM(AMIGA)
+    // Rules inserted into active sheets since the last update, kept while the
