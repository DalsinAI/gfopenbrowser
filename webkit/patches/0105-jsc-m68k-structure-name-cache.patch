         s.watchedCompiles, " compiled with ", s.watchedSites, " empty caches, ", s.retires, " replaced (", s.retiredBytes, " bytes kept)");
     dataLogLn("68k interpreter caches: get_by_id ", s.getByIdMisses, " misses (", s.getByIdMissesInCode, " in compiled CodeBlocks, ", s.getByIdRecaches, " replaced another structure), put_by_id ",
         s.putByIdMisses, " (", s.putByIdMissesInCode, " in compiled, ", s.putByIdRecaches, " replaced), get_by_val ", s.getByValMisses, " (", s.getByValNamedMisses, " named), put_by_val ", s.putByValMisses);
+    dataLogLn("68k structure+name cache: ", s.megamorphicHits, " answered (", s.megamorphicAbsentHits, " absent), ", s.megamorphicFills, " filled");
     dataLogLn("68k get_by_id misses by kind: own value ", missKinds[0], ", prototype value ", missKinds[1], ", getter ", missKinds[2],
         ", custom accessor ", missKinds[3], ", unset ", missKinds[4], ", uncacheable ", missKinds[5], ", not a cell ", missKinds[6]);
     Locker locker { stateLock };
