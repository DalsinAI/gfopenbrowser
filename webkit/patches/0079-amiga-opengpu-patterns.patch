+// A picture's tile as paint: the tile's pixels to the user's space, and
+// filter 0 nearest, 1 bilinear. false when OpenGPU can't take it (not
+// ARGB32 or RGB24, past the fixed point).
+bool GraphicsContextOpenGPU::pictureFor(cairo_surface_t* surface, const IntRect& tile, const AffineTransform& tileToUser, int filter, Paint& paint)
+{
+    if (!surface || cairo_surface_get_type(surface) != CAIRO_SURFACE_TYPE_IMAGE)
+        return false;
+    cairo_format_t format = cairo_image_surface_get_format(surface);
+    if (format != CAIRO_FORMAT_ARGB32 && format != CAIRO_FORMAT_RGB24)
+        return false;
+    cairo_surface_flush(surface);
+    auto& p = paint.pattern;
+    p.source.address = reinterpret_cast<uintptr_t>(cairo_image_surface_get_data(surface));
+    p.source.bpr = cairo_image_surface_get_stride(surface);
+    p.source.w = cairo_image_surface_get_width(surface);
+    p.source.h = cairo_image_surface_get_height(surface);
+    p.source.format = format == CAIRO_FORMAT_RGB24 ? OBGPU_RGB : OBGPU_ARGB;
+    if (!p.source.address || tile.x() < 0 || tile.y() < 0 || tile.isEmpty() || tile.maxX() > p.source.w || tile.maxY() > p.source.h)
+        return false;
+    p.x = tile.x();
+    p.y = tile.y();
+    p.w = tile.width();
+    p.h = tile.height();
+    double m[6] = { tileToUser.a(), tileToUser.b(), tileToUser.c(), tileToUser.d(), tileToUser.e(), tileToUser.f() };
+    for (int i = 0; i < 6; i++) {
+        bool linear = i < 4;
+        if (!(std::abs(m[i]) < (linear ? 32767 : (1 << 22))))
+            return false;
+        p.m[i] = std::lround(m[i] * (linear ? 65536 : 256));
+    }
+    p.edge = OBGPU_PATTERN_REPEAT;
+    p.bilinear = filter;
+    p.alpha = 255;
+    paint.hasPattern = true;
+    paint.picture = surface;
+    return true;
+}
+
+// The picture a drawn paint uses, held until the batch is drawn.
+void GraphicsContextOpenGPU::keepPicture(const Paint& paint)
+{
+    if (paint.picture && obgpu_pending(m_gpu))
+        m_pictures.append(paint.picture);
+}
+
+// A pattern brush as PatternCairo.cpp makes it: the tile image under the
+// pattern's space, repeated (cairo's EXTEND_REPEAT), cairo's default
+// filter (GOOD: bilinear where the picture is not shrunk). Only where
+// OpenGPU draws what cairo does: repeated both ways (one way is cairo's
+// clip by the tile), no global alpha, and the picture neither shrunk nor
+// turned on the target (GOOD is not bilinear there).
+bool GraphicsContextOpenGPU::patternFor(const Pattern& pattern, float globalAlpha, Paint& paint)
+{
+    if (globalAlpha < 1 || !pattern.repeatX() || !pattern.repeatY())
+        return false;
+    auto image = pattern.tileNativeImage();
+    if (!image)
+        return false;
+    auto surface = image->platformImage();
+    if (!surface)
+        return false;
+    auto device = getCTM(PossiblyIncludeDeviceScale) * pattern.patternSpaceTransform();
+    if (device.b() || device.c() || device.a() < 1 || device.d() < 1)
+        return false;
+    IntRect tile(0, 0, cairo_image_surface_get_width(surface.get()), cairo_image_surface_get_height(surface.get()));
+    return pictureFor(surface.get(), tile, pattern.patternSpaceTransform(), 1, paint);
+}
