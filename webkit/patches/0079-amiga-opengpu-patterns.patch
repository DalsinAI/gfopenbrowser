+// As CairoUtilities' drawPatternToCairoContext: the tile repeated under the
+// pattern transform from the phase, by the options' operator, over the
+// destination rectangle (cairo_fill: anti-aliased as the context, no
+// global alpha). Here: tiles on whole pixels of the picture, no spacing
+// (cairo makes a padded copy), normal blending, and cairo's filters where
+// OpenGPU has them: FAST nearest, BILINEAR, and GOOD or BEST only where
+// the picture is neither shrunk nor turned on the target.
 void GraphicsContextOpenGPU::drawPattern(const NativeImage& image, const FloatRect& destRect, const FloatRect& tileRect, const AffineTransform& patternTransform, const FloatPoint& phase, const FloatSize& spacing, ImagePaintingOptions options)
 {
+    cairo_surface_t* surface = image.platformImage().get();
+    if (surface && std::isfinite(phase.x()) && std::isfinite(phase.y()) && spacing.isZero()
+        && options.blendMode() == BlendMode::Normal && pathsWanted()) {
+        IntRect tile = enclosingIntRect(tileRect);
+        int filter = -1;
+        auto device = getCTM(PossiblyIncludeDeviceScale) * patternTransform;
+        switch (options.interpolationQuality()) {
+        case InterpolationQuality::DoNotInterpolate:
+        case InterpolationQuality::Low:
+            filter = 0;
+            break;
+        case InterpolationQuality::Default:
+            filter = 1;
+            break;
+        default:
+            if (!device.b() && !device.c() && device.a() >= 1 && device.d() >= 1)
+                filter = 1;
+            break;
+        }
+        // the tile's pixels to the user's space, the phase reduced by whole tiles as cairo's
+        double periodX = tileRect.width() * patternTransform.a(), periodY = tileRect.height() * patternTransform.d();
+        double phaseX = phase.x() + tileRect.x() * patternTransform.a(), phaseY = phase.y() + tileRect.y() * patternTransform.d();
+        if (periodX)
+            phaseX -= std::trunc(phaseX / periodX) * periodX;
+        if (periodY)
+            phaseY -= std::trunc(phaseY / periodY) * periodY;
+        AffineTransform tileToUser(patternTransform.a(), patternTransform.b(), patternTransform.c(), patternTransform.d(),
+            patternTransform.e() + phaseX, patternTransform.f() + phaseY);
+        Paint paint;
+        if (filter >= 0 && FloatRect(tile) == tileRect && pictureFor(surface, tile, tileToUser, filter, paint)) {
+            Path path;
+            path.addRect(destRect);
+            if (fillPathWith(path, paint, false, options.compositeOperator()))
+                return;
+        }
+    }
     handOn(OBGPU_PATTERN);
     m_cairo.drawPattern(image, destRect, tileRect, patternTransform, phase, spacing, options);
 }
