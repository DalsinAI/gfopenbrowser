+static long magnitude(long v)
+{
+    return v < 0 ? -v : v;
+}
+
+static int patternOk(const struct obgpu_pattern *p)
+{
+    const struct obgpu_source *s = &p->source;
+    if (s->w <= 0 || s->h <= 0 || s->w > OBGPU_MAX_SIDE || s->h > OBGPU_MAX_SIDE || s->bpr < (long)s->w * 4
+        || s->bpr > 0x01000000L || (s->format != OBGPU_ARGB && s->format != OBGPU_RGB) || !s->address)
+        return 0;
+    if (p->x < 0 || p->y < 0 || p->w <= 0 || p->h <= 0 || p->x + p->w > s->w || p->y + p->h > s->h)
+        return 0;
+    return (p->edge == OBGPU_PATTERN_NONE || p->edge == OBGPU_PATTERN_REPEAT) && p->alpha <= 255;
+}
+
+/* The pattern's words in scratch at the batch's end, its picture in a slot:
+ * its matrix the transform times its own. 0 when they do not fit. */
+static int patternWords(struct obgpu *g, const struct obgpu_pattern *p, unsigned long *address)
+{
+    const long *c = current(g)->m, *m = p->m;
+    obgpu_s64 t[6];
+    unsigned long mw[6];
+    unsigned char *q;
+    int i, slot;
+    t[0] = mul1616(c[0], m[0]) + mul1616(c[2], m[1]);
+    t[1] = mul1616(c[1], m[0]) + mul1616(c[3], m[1]);
+    t[2] = mul1616(c[0], m[2]) + mul1616(c[2], m[3]);
+    t[3] = mul1616(c[1], m[2]) + mul1616(c[3], m[3]);
+    t[4] = mul16(c[0], m[4]) + mul16(c[2], m[5]) + c[4];
+    t[5] = mul16(c[1], m[4]) + mul16(c[3], m[5]) + c[5];
+    if (!matrixWords(t, mw))
+        return 0;
+    /* nearest: a pixel centre exactly between two of the picture's pixels
+     * takes the one before, as pixman's (its position less pixman_fixed_e):
+     * the picture moved by a 65536th of its own pixel, at least */
+    if (!p->bilinear) {
+        long sx = magnitude((long)mw[0]) + magnitude((long)mw[1]), sy = magnitude((long)mw[3]) + magnitude((long)mw[4]);
+        mw[2] = (unsigned long)((long)mw[2] + ((sx + 0xFFFF) >> 16) + 1);
+        mw[5] = (unsigned long)((long)mw[5] + ((sy + 0xFFFF) >> 16) + 1);
+    }
+    slot = slotOf(g, &p->source);
+    q = g->scratch + g->scratch_used * 4;
+    put(q, (unsigned long)slot);
+    put(q + 4, (p->edge == OBGPU_PATTERN_REPEAT ? OGPU_PATTERN_REPEAT : OGPU_PATTERN_NONE)
+        | (p->bilinear ? OGPU_PATTERN_BILINEAR : 0));
+    put(q + 8, xy(p->x, p->y));
+    put(q + 12, xy(p->w, p->h));
+    for (i = 0; i < 6; i++)
+        put(q + 16 + i * 4, mw[i]);
