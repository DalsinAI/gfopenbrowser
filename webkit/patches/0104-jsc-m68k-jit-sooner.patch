+    uint64_t getByValMisses { 0 };
+    uint64_t getByValNamedMisses { 0 }; // ... with a string or symbol key
+    uint64_t putByValMisses { 0 };
+};
+extern Statistics statistics;
+// True when JSC_reportM68KTemplateJITStatistics is set; the first call
+// registers the report for exit.
+bool countStatistics();
+
