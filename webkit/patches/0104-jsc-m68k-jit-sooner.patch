+// What a CodeBlock's code needs beyond its CodeBlock's fields (item 6): the
+// cache words to watch for a second compile, and the code it replaced. Code
+// that has been replaced is kept, with its structure tables kept up to date,
+// until the CodeBlock dies, because a frame or a caller's call can still be
+// in it; it leaves through jsc_m68k_tjit_redispatch to the CodeBlock's
+// current code like any compiled code.
+struct Retired {
+    void* code;
+    GetByIdTables* tables;
+};
+struct State {
+    Vector<FastPaths::Watch> watches;
+    Vector<Retired> retired;
+    bool recompiled { false };
+};
+
+Lock stateLock;
+HashMap<CodeBlock*, std::unique_ptr<State>>& states() WTF_REQUIRES_LOCK(stateLock)
