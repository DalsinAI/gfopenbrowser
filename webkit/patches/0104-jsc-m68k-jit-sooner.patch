 }
 
+void reconcileCaches(CodeBlock* codeBlock, VM& vm)
+{
+    if (codeBlock->m_m68kTemplateMap)
+        reconcileTables(static_cast<GetByIdTables*>(codeBlock->m_m68kTemplateMap[codeBlock->m_m68kTemplateMapSize]), vm);
+
+    Locker locker { stateLock };
+    auto it = states().find(codeBlock);
+    if (it == states().end())
+        return;
+    State& state = *it->value;
+    for (auto& retired : state.retired)
+        reconcileTables(retired.tables, vm);
+    // Item 6: code compiled while some sites' caches were empty is replaced
+    // once, after one of them has filled (run by the code's template copy).
+    // This runs before the interpreter's caches drop dead structures, so a
+    // word that filled since the compile reads non-zero here. The CodeBlock
+    // goes back to the interpreter, which compiles it again after it has
+    // run a while longer (m68kTemplateJITRecompileThreshold).
+    if (state.recompiled || state.watches.isEmpty() || !codeBlock->m_m68kTemplateMap)
+        return;
+    bool changed = false;
+    for (auto& watch : state.watches) {
+        if (*watch.word != watch.value) {
+            changed = true;
+            break;
+        }
+    }
+    if (!changed)
+        return;
+    state.retired.append({ codeBlock->m_m68kTemplateCode, static_cast<GetByIdTables*>(codeBlock->m_m68kTemplateMap[codeBlock->m_m68kTemplateMapSize]) });
+    if (countStatistics()) {
+        ++statistics.retires;
+        statistics.retiredBytes += static_cast<uint8_t*>(codeBlock->m_m68kTemplateMap[codeBlock->m_m68kTemplateMapSize]) - static_cast<uint8_t*>(codeBlock->m_m68kTemplateCode);
+    }
+    fastFree(codeBlock->m_m68kTemplateMap);
+    codeBlock->m_m68kTemplateCode = nullptr;
+    codeBlock->m_m68kTemplateMap = nullptr;
+    codeBlock->m_m68kTemplateEntry = nullptr;
+    codeBlock->m_m68kTemplateMapSize = 0;
+    state.watches.clear();
+    state.recompiled = true;
+    codeBlock->unlinkedCodeBlock()->llintExecuteCounter().setNewThreshold(Options::m68kTemplateJITRecompileThreshold(), codeBlock);
+}
+
 void release(CodeBlock* codeBlock)
 {
+    {
+        Locker locker { stateLock };
+        auto it = states().find(codeBlock);
+        if (it != states().end()) {
+            for (auto& retired : it->value->retired)
+                fastFree(retired.code);
+            states().remove(it);
+        }
+    }
     fastFree(codeBlock->m_m68kTemplateCode);
     fastFree(codeBlock->m_m68kTemplateMap);
     codeBlock->m_m68kTemplateCode = nullptr;
@@ -4420,6 +4572,20 @@ void release(CodeBlock* codeBlock)
     codeBlock->m_m68kTemplateMapSize = 0;
 }
 
