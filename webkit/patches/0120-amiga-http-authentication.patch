+// HTTP log-ins (Basic and Digest) the user gave this run, by server and
+// realm, so that the page's other parts and the next pages on the same
+// server don't ask again. Kept in memory only, never written out.
+static HashMap<String, std::pair<String, String>>& amigaCredentials()
+{
+    static NeverDestroyed<HashMap<String, std::pair<String, String>>> credentials;
+    return credentials;
+}
+
+static String amigaCredentialKey(const URL& url, const String& realm)
+{
+    return makeString(url.protocol(), "://"_s, url.host(), ':', url.port().value_or(defaultPortForProtocol(url.protocol()).value_or(0)), '\n', realm);
+}
+
+// A 401 with a Basic or Digest challenge: credentials kept for its server
+// and realm go out once without asking; otherwise the window is asked
+// through the frame loader client (dispatchDidReceiveAuthenticationChallenge),
+// which answers on this handle as its AuthenticationClient, now or later.
+// The body waits meanwhile (openweb.fetch sends it after the response is
+// taken). Returns false when the response goes to the page as it is.
+bool ResourceHandle::amigaAuthenticate(const ResourceRequest& sentRequest, const ResourceResponse& response)
+{
+    static constexpr unsigned maxRefusals = 3;
+    if (!response.isUnauthorized() || !d->m_webFetch || hasAuthenticationChallenge())
+        return false;
+    AuthenticationChallenge challenge(response, d->m_amigaAuthFailures, *this);
+    auto scheme = challenge.protectionSpace().authenticationScheme();
+    if (scheme != ProtectionSpace::AuthenticationScheme::HTTPBasic && scheme != ProtectionSpace::AuthenticationScheme::HTTPDigest)
+        return false;
+
+    auto key = amigaCredentialKey(response.url(), challenge.protectionSpace().realm());
+    bool sentCredentials = !d->m_user.isEmpty() && protocolHostAndPortAreEqual(response.url(),
+        d->m_amigaCredentialURL.isNull() ? d->m_firstRequest.url() : d->m_amigaCredentialURL);
+    if (sentCredentials) {
+        // Refused: those kept for the realm are wrong now.
+        auto kept = amigaCredentials().find(key);
+        if (kept != amigaCredentials().end() && kept->value.first == d->m_user && kept->value.second == d->m_password)
+            amigaCredentials().remove(kept);
+        if (++d->m_amigaAuthFailures >= maxRefusals)
+            return false;
+        challenge = AuthenticationChallenge(response, d->m_amigaAuthFailures, *this);
+    } else {
+        auto kept = amigaCredentials().find(key);
+        if (kept != amigaCredentials().end()) {
+            d->m_amigaAuthRequest = sentRequest;
+            d->m_amigaAuthResponse = response;
+            auto credential = kept->value;
+            amigaRetryWithCredential(credential.first, credential.second);
+            return true;
+        }
+    }
+
+    d->m_amigaAuthRequest = sentRequest;
+    d->m_amigaAuthResponse = response;
+    d->m_currentWebChallenge = challenge;
+    Ref protectedThis { *this };
+    client()->didReceiveAuthenticationChallenge(this, challenge);
+    return true;
+}
+
+void ResourceHandle::amigaRetryWithCredential(const String& user, const String& password)
+{
+    d->m_user = user;
+    d->m_password = password;
+    d->m_amigaCredentialURL = d->m_amigaAuthResponse.url();
+    ResourceRequest request = std::exchange(d->m_amigaAuthRequest, { });
+    d->m_amigaAuthResponse = { };
+    // amigaStartRequest() gives the request its cookies again.
+    request.removeHTTPHeaderField(HTTPHeaderName::Cookie);
+    request.removeHTTPHeaderField(HTTPHeaderName::Authorization);
+    amigaCancelRequest();
+    amigaStartRequest(WTF::move(request));
+}
+
 void ResourceHandle::amigaDidReceiveResponse(const ResourceRequest& sentRequest, const Vector<String>& headerLines, ResourceResponse&& response)
 {
     if (!client())
@@ -316,6 +394,16 @@ void ResourceHandle::amigaDidReceiveResponse(const ResourceRequest& sentRequest,
         }
     }
 
+    if (amigaAuthenticate(sentRequest, response))
+        return;
+    amigaContinueResponse(sentRequest, WTF::move(response));
+}
+
+void ResourceHandle::amigaContinueResponse(const ResourceRequest& sentRequest, ResourceResponse&& response)
+{
+    if (!client())
+        return;
+
     if (auto& cache = d->m_httpCache) {
         if (response.httpStatusCode() == 304) {
             if (cache->notModified(response)) {
@@ -399,6 +487,12 @@ public:
         m_response = WTF::move(response);
         completionHandler();
     }
+    // No log-in panel for a synchronous load: the 401 is its answer.
+    void didReceiveAuthenticationChallenge(ResourceHandle*, const AuthenticationChallenge& challenge) final
+    {
+        if (RefPtr client = challenge.authenticationClient())
+            client->receivedRequestToContinueWithoutCredential(challenge);
+    }
     void didReceiveData(ResourceHandle*, const SharedBuffer& buffer, int) final { m_data.append(buffer.span()); }
     void didFinishLoading(ResourceHandle*, const NetworkLoadMetrics&) final { m_done = true; }
     void didFail(ResourceHandle*, const ResourceError& error) final
@@ -435,24 +529,52 @@ void ResourceHandle::didReceiveAuthenticationChallenge(const AuthenticationChall
 {
 }
 
-void ResourceHandle::receivedCredential(const AuthenticationChallenge&, const Credential&)
+// The window's answer to amigaAuthenticate(): a log-in, to send the request
+// again with; nothing, and the 401 goes to the page as it came; or Cancel.
+void ResourceHandle::receivedCredential(const AuthenticationChallenge& challenge, const Credential& credential)
 {
+    if (!hasAuthenticationChallenge())
+        return;
+    if (credential.user().isEmpty()) {
+        receivedRequestToContinueWithoutCredential(challenge);
+        return;
+    }
+    clearAuthentication();
+    if (credential.persistence() != CredentialPersistence::None)
+        amigaCredentials().set(amigaCredentialKey(d->m_amigaAuthResponse.url(), challenge.protectionSpace().realm()), std::make_pair(credential.user(), credential.password()));
+    amigaRetryWithCredential(credential.user(), credential.password());
 }
 
 void ResourceHandle::receivedRequestToContinueWithoutCredential(const AuthenticationChallenge&)
 {
+    if (!hasAuthenticationChallenge())
+        return;
+    clearAuthentication();
+    ResourceRequest request = std::exchange(d->m_amigaAuthRequest, { });
+    ResourceResponse response = std::exchange(d->m_amigaAuthResponse, { });
+    amigaContinueResponse(request, WTF::move(response));
 }
 
-void ResourceHandle::receivedCancellation(const AuthenticationChallenge&)
+void ResourceHandle::receivedCancellation(const AuthenticationChallenge& challenge)
 {
+    if (!hasAuthenticationChallenge())
+        return;
+    clearAuthentication();
+    d->m_amigaAuthRequest = { };
+    d->m_amigaAuthResponse = { };
+    amigaCancelRequest();
+    if (client())
+        client()->receivedCancellation(this, challenge);
 }
 
-void ResourceHandle::receivedRequestToPerformDefaultHandling(const AuthenticationChallenge&)
+void ResourceHandle::receivedRequestToPerformDefaultHandling(const AuthenticationChallenge& challenge)
 {
+    receivedRequestToContinueWithoutCredential(challenge);
 }
 
-void ResourceHandle::receivedChallengeRejection(const AuthenticationChallenge&)
+void ResourceHandle::receivedChallengeRejection(const AuthenticationChallenge& challenge)
 {
+    receivedRequestToContinueWithoutCredential(challenge);
 }
 
 } // namespace WebCore
