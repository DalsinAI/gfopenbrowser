+    // Bit operations on numbers (patch 0101, item 5 of the 3 Nov 2026
+    // engine study). JavaScript does &, |, ^, ~, << and >> on ToInt32 of
+    // its operands. The int32 code does them in a data register; an
+    // operand that is a double (an int32 sum that overflowed, x >>> 0
+    // above 2^31, a product) goes to the float path below, which truncates
+    // it on the FPU, where the interpreter would call the C slow path.
+    static bool isBitOperation(OpcodeID opcode)
+    {
+        switch (opcode) {
+        case op_bitand: case op_bitor: case op_bitxor:
+        case op_lshift: case op_rshift: case op_urshift:
+        case op_bitnot: case op_unsigned:
+            return true;
+        default:
+            return false;
+        }
+    }
+    // A bit operation's operand: a numeric constant becomes its ToInt32,
+    // as the operation would make it.
+    Operand bitOperand(VirtualRegister reg)
+    {
+        if (reg.isConstant()) {
+            Operand op;
+            JSValue value = m_codeBlock->getConstant(reg);
+            if (value.isNumber()) {
+                op.valid = true;
+                op.isConstant = true;
+                op.constant = value.isInt32() ? value.asInt32() : toInt32(value.asDouble());
+            }
+            return op;
+        }
+        return operandFor(m_codeBlock, reg);
+    }
+    // ToInt32 of a number in the frame into dn: an int32 as it is, a double
+    // truncated on the FPU. A double from -2^31 to 2^31 truncates towards
+    // zero (FPCR's round-to-zero, for the one fmove.l); one from 2^31 to 2^32
+    // (a uint32, from >>> 0) less 2^32, rounding down. Anything else (a
+    // larger double, infinity, NaN, a non-number) takes the slow path. The
+    // work is a routine written once per compiled function, the first time a
+    // float path needs it, which each operand calls: lea, bsr, bne. It
+    // takes a0, the value's address, and gives d0 with Z set, or Z clear for
+    // the slow path; it uses d0, a0 and fp0, and FPCR is saved on the stack
+    // and put back. Like the rest of the JIT's float code it reads doubles
+    // under the task's FPCR precision (extended or double, never single).
+    static constexpr uint64_t doubleTwo31 = 0x41e0000000000000ull;
+    static constexpr uint64_t doubleMinusTwo31 = 0xc1e0000000000000ull;
+    static constexpr uint64_t doubleTwo32 = 0x41f0000000000000ull;
+    static constexpr uint32_t fpcrRoundToZero = 0x10;
+    static constexpr uint32_t fpcrRoundDown = 0x20;
+    void truncateRoutine()
+    {
+        m_hot.word(0x0c90); m_hot.longWord(int32Tag); // cmpi.l #int32Tag,(a0)
+        size_t notInt32 = m_hot.branchShort(Builder::NotEqual);
+        m_hot.loadDisp(0, 4, 0); // move.l 4(a0),d0
+        size_t done = m_hot.size();
+        m_hot.word(0x003c); m_hot.word(0x0004); // ori #4,ccr: Z, done
+        m_hot.word(0x4e75); // rts
+        size_t fail = m_hot.size();
+        m_hot.word(0x023c); m_hot.word(0x00fb); // andi #~4,ccr: not Z, the slow path
+        m_hot.word(0x4e75); // rts
+        m_hot.bindShort(notInt32);
+        m_hot.word(0x2010); // move.l (a0),d0
+        m_hot.cmpImm(doubleEncodeOffsetHigh, 0);
+        m_hot.branchToBuffer(Builder::CarrySet, fail); // below every encoded double: a cell or other
+        m_hot.subImm(doubleEncodeOffsetHigh, 0);
+        m_hot.word(0x2f28); m_hot.word(4); // move.l 4(a0),-(sp)
+        m_hot.push(0);
+        m_hot.fmoveDoublePop(0);
+        m_hot.fopDoubleImm(Builder::FPCompare, doubleTwo31, 0); // fp0 - 2^31
+        size_t big = m_hot.fbranchShort(Builder::FPOrderedGreaterEqual);
+        m_hot.fopDoubleImm(Builder::FPCompare, doubleMinusTwo31, 0);
+        size_t inRange = m_hot.fbranchShort(Builder::FPOrderedGreaterEqual);
+        m_hot.branchToBuffer(Builder::Always, fail); // below -2^31, or NaN
+        m_hot.bindFShort(big);
+        m_hot.fopDoubleImm(Builder::FPCompare, doubleTwo32, 0);
+        m_hot.fbranchToBuffer(Builder::FPOrderedGreaterEqual, fail); // 2^32 or more
+        m_hot.fopDoubleImm(Builder::FPSub, doubleTwo32, 0); // exact, at double precision whatever FPCR says
+        m_hot.pushFPCR();
+        m_hot.setFPCR(fpcrRoundDown);
+        size_t convert = m_hot.branchShort(Builder::Always);
+        m_hot.bindFShort(inRange);
+        m_hot.pushFPCR();
+        m_hot.setFPCR(fpcrRoundToZero);
+        m_hot.bindShort(convert);
+        m_hot.fmoveToLong(0, 0);
+        m_hot.popFPCR();
+        m_hot.branchToBuffer(Builder::Always, done);
+    }
+    void truncateToInt32(const Operand& op, unsigned dn)
+    {
+        if (op.isConstant) {
+            m_hot.moveImm(op.constant, dn);
+            return;
+        }
+        if (m_truncateRoutine == SIZE_MAX) {
+            size_t over = m_hot.branch(Builder::Always);
+            m_truncateRoutine = m_hot.size();
+            truncateRoutine();
+            m_hot.bindBranch(over);
+        }
+        m_hot.leaFrame(op.hi, 0);
+        m_hot.callBuffer(m_truncateRoutine);
+        slowUnless(Builder::NotEqual);
+        if (dn)
+            m_hot.moveReg(0, dn);
+    }
+    // dn op= rhs, rhs an int32 constant or already in register rhsReg (the
+    // int32 code passes the frame's slot instead, rhsReg ~0u).
+    void bitOperation(OpcodeID opcode, unsigned dn, const Operand& rhs, unsigned rhsReg)
+    {
+        Builder::Shift shift = Builder::ShiftLeft;
+        switch (opcode) {
+        case op_bitand:
+            if (rhs.isConstant)
+                m_hot.andImm(rhs.constant, dn);
+            else if (rhsReg != ~0u)
+                m_hot.andReg(rhsReg, dn);
+            else
+                m_hot.andFrame(rhs.lo, dn);
+            return;
+        case op_bitor:
+            if (rhs.isConstant)
+                m_hot.orImm(rhs.constant, dn);
+            else if (rhsReg != ~0u)
+                m_hot.orReg(rhsReg, dn);
+            else
+                m_hot.orFrame(rhs.lo, dn);
+            return;
+        case op_bitxor:
+            if (rhs.isConstant)
+                m_hot.eorImm(rhs.constant, dn);
+            else {
+                if (rhsReg == ~0u) {
+                    m_hot.loadFrame(rhs.lo, 1);
+                    rhsReg = 1;
+                }
+                m_hot.eorReg(rhsReg, dn);
+            }
+            return;
+        case op_lshift: shift = Builder::ShiftLeft; break;
+        case op_rshift: shift = Builder::ShiftRightArithmetic; break;
+        case op_urshift: shift = Builder::ShiftRightLogical; break;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        // JavaScript shifts by the count's low five bits.
+        if (rhs.isConstant) {
+            unsigned count = rhs.constant & 31;
+            if (!count)
+                return;
+            if (count <= 8)
+                m_hot.shiftImm(shift, count, dn);
+            else {
+                m_hot.moveq(count, 1);
+                m_hot.shiftReg(shift, 1, dn);
+            }
+            return;
+        }
+        if (rhsReg == ~0u)
+            m_hot.loadFrame(rhs.lo, 1);
+        else if (rhsReg != 1)
+            m_hot.moveReg(rhsReg, 1);
+        m_hot.andImm(31, 1);
+        m_hot.shiftReg(shift, 1, dn);
+    }
+    // &, |, ^, <<, >> and >>> (whose result the interpreter also keeps as an
+    // int32's bits; op_unsigned after it makes the number).
+    template<typename Op>
+    bool bitBinary(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<Op>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand lhs = bitOperand(bytecode.m_lhs);
+        Operand rhs = bitOperand(bytecode.m_rhs);
+        if (!dst.valid || dst.isConstant || !lhs.valid || !rhs.valid || (lhs.isConstant && rhs.isConstant))
+            return false;
+        OpcodeID opcode = instruction->opcodeID();
+        useFloatPath(opcode, dst, lhs, rhs);
+        checkInt32(lhs);
+        checkInt32(rhs);
+        load(lhs, 0);
+        bitOperation(opcode, 0, rhs, ~0u);
+        storeInt32(0, dst, same(dst, lhs) || same(dst, rhs));
+        return true;
+    }
+    bool bitNot(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpBitnot>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand operand = operandFor(m_codeBlock, bytecode.m_operand);
+        if (!dst.valid || dst.isConstant || !operand.valid || operand.isConstant)
+            return false;
+        useFloatPath(op_bitnot, dst, operand, operand);
+        checkInt32(operand);
+        m_hot.loadFrame(operand.lo, 0);
+        m_hot.notReg(0);
+        storeInt32(0, dst, same(dst, operand));
+        return true;
+    }
+    // op_unsigned, after >>>: an int32 of 0 or more stays as it is; a
+    // negative one (2^31 and up as a uint32) becomes a double in the float
+    // path.
+    bool toUnsigned(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpUnsigned>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand operand = operandFor(m_codeBlock, bytecode.m_operand);
+        if (!dst.valid || dst.isConstant || !operand.valid || operand.isConstant)
+            return false;
+        useFloatPath(op_unsigned, dst, operand, operand);
+        checkInt32(operand);
+        m_hot.tstFrame(operand.lo);
+        bailUnless(Builder::Minus);
+        if (!same(dst, operand)) {
+            m_hot.copyFrame(operand.hi, dst.hi);
+            m_hot.copyFrame(operand.lo, dst.lo);
+        }
+        return true;
+    }
+    void floatBitOperation(OpcodeID opcode, const Operand& dst, const Operand& lhs, const Operand& rhs)
+    {
+        if (opcode == op_unsigned) {
+            // A negative int32 here (anything else is the slow path's).
+            m_hot.cmpFrameImm(int32Tag, lhs.hi);
+            slowUnless(Builder::NotEqual);
+            m_hot.fmoveLongFrame(lhs.lo, 0);
+            m_hot.fopDoubleImm(Builder::FPAdd, doubleTwo32, 0);
+            boxDouble(0, dst);
+            return;
+        }
+        if (opcode == op_bitnot) {
+            truncateToInt32(lhs, 0);
+            m_hot.notReg(0);
+            storeInt32(0, dst, false);
+            return;
+        }
+        // rhs first: truncating uses d0.
+        if (!rhs.isConstant)
+            truncateToInt32(rhs, 1);
+        truncateToInt32(lhs, 0);
+        bitOperation(opcode, 0, rhs, 1);
+        storeInt32(0, dst, false);
+    }
+
