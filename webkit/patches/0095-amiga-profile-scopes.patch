diff --git a/Source/JavaScriptCore/runtime/Completion.h b/Source/JavaScriptCore/runtime/Completion.h
--- a/Source/JavaScriptCore/runtime/Completion.h
+++ b/Source/JavaScriptCore/runtime/Completion.h
@@ -83,4 +83,37 @@
 JS_EXPORT_PRIVATE UncheckedKeyHashMap<RefPtr<UniquedStringImpl>, String> retrieveImportAttributesFromDynamicImportOptions(JSGlobalObject*, JSValue, const Vector<RefPtr<UniquedStringImpl>>& supportedAssertions);
 JS_EXPORT_PRIVATE std::optional<ScriptFetchParameters::Type> retrieveTypeImportAttribute(JSGlobalObject*, const UncheckedKeyHashMap<RefPtr<UniquedStringImpl>, String>&);
 
+// Where a page's time goes (GFOpenBrowser's profile, obcore-view -profile):
+// begin and end of compiling a script's or a function's code (parse and
+// bytecode), of a script run from the top, of a call into JavaScript (an
+// event, a timer), of a style update and of a layout. The program sets the
+// hooks; unset, each scope costs a test.
+class SourceProvider;
+enum OBProfileKind { OBProfileCompile, OBProfileEvaluate, OBProfileCall, OBProfileStyle, OBProfileLayout };
+struct OBProfileHooks {
+    void (*begin)(int kind, const SourceProvider*);
+    void (*end)(int kind, const SourceProvider*);
+};
+JS_EXPORT_PRIVATE extern OBProfileHooks obProfileHooks;
+
+class OBProfileScope {
+    WTF_MAKE_NONCOPYABLE(OBProfileScope);
+public:
+    explicit OBProfileScope(int kind, const SourceProvider* provider = nullptr)
+        : m_kind(kind)
+        , m_provider(provider)
+    {
+        if (obProfileHooks.begin)
+            obProfileHooks.begin(kind, provider);
+    }
+    ~OBProfileScope()
+    {
+        if (obProfileHooks.end)
+            obProfileHooks.end(m_kind, m_provider);
+    }
+private:
+    int m_kind;
+    const SourceProvider* m_provider;
+};
+
 } // namespace JSC
